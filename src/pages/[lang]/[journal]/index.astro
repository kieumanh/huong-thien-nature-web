---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ContemplativeScene from '../../../components/ContemplativeScene.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Arrow from '../../../components/Arrow.astro';
import { languages, type Language } from '../../../data/site';
import { articles, articlePath, journalPath } from '../../../data/articles';
import { journalTopics, laneArticles, readingLanes, topicOf } from '../../../data/journal-topics';
import { contactPath } from '../../../data/contact-channels';
import '../../../styles/editorial.css';

export function getStaticPaths() {
  return languages.map(lang => ({ params: { lang, journal: lang === 'vi' ? 'tan-van' : 'journal' } }));
}
const lang = Astro.params.lang as Language;
const en = lang === 'en';
const title = en ? 'Journal' : 'Tản văn';
const description = en
  ? 'Reflections on meditation, healing, nature and everyday life, with small practices to try at your own pace.'
  : 'Những bài viết về thiền định, chữa lành, thiên nhiên và đời sống thường ngày, kèm những thực tập nhỏ để bạn thử theo nhịp của mình.';
const alternatePath = journalPath(en ? 'vi' : 'en');
const counts = Object.fromEntries(journalTopics.map(topic => [topic.id, articles.filter(article => topicOf(article) === topic.id).length]));
const unit = en ? 'articles' : 'bài đọc';
---
<BaseLayout {lang} title={`${title} | Hương Thiền Nature`} {description} {alternatePath}>
  <Header {lang} {alternatePath} />
  <main id="main-content" tabindex="-1" class="journal-listing">
    <header class="journal-listing-header shell">
      <ContemplativeScene motif="mandala" />
      <Breadcrumb {lang} current={title} />
      <div class="journal-intro">
        <p class="eyebrow">{en ? 'Meditation · Healing · Life' : 'Thiền · Chữa lành · Đời sống'}</p>
        <h1>{title}</h1>
        <p class="lead">{description}</p>
      </div>
    </header>

    <section class="shell journal-lanes" aria-labelledby="journal-lanes-title">
      <h2 id="journal-lanes-title">{en ? 'Not sure where to begin?' : 'Không biết bắt đầu từ đâu?'}</h2>
      <p class="journal-lanes__intro">{en ? 'Choose the lane closest to how you feel today. Each one is a short, ordered reading path.' : 'Chọn lối gần nhất với điều bạn đang cảm thấy hôm nay. Mỗi lối là vài bài đọc ngắn, theo thứ tự.'}</p>
      <ol class="journal-lanes__list">
        {readingLanes.map((lane, index) => <li class="journal-lane zen-card">
          <p class="journal-lane__head"><span class="journal-lane__number" aria-hidden="true">{index + 1}</span><span>{laneArticles(lane.slugs).length} {unit}</span></p>
          <h3>{lane.title[lang]}</h3>
          <p>{lane.note[lang]}</p>
          <ol>{laneArticles(lane.slugs).map(article => <li><a href={articlePath(lang, article.slug)}>{article.translations[lang].title}</a></li>)}</ol>
        </li>)}
      </ol>
    </section>

    <section class="shell journal-listing-articles" id="journal-articles" aria-labelledby="journal-articles-title">
      <div class="section-heading">
        <h2 id="journal-articles-title">{en ? 'Browse the library' : 'Tìm trong thư viện'}</h2>
        <p class="journal-count" data-journal-count role="status" aria-live="polite" aria-atomic="true">{articles.length} {unit}</p>
      </div>
      <div class="journal-topics" role="group" aria-label={en ? 'Filter articles by topic' : 'Lọc bài viết theo chủ đề'} data-journal-topics>
        <button type="button" class="journal-topic" data-topic="all" aria-pressed="true">{en ? 'All' : 'Tất cả'} <span>{articles.length}</span></button>
        {journalTopics.map(topic => <button type="button" class="journal-topic" data-topic={topic.id} aria-pressed="false">{topic.label[lang]} <span>{counts[topic.id]}</span></button>)}
      </div>
      <div class="journal-grid journal-grid--library" id="journal-grid">{articles.map((article, index) => <ArticleCard {article} {lang} heading="h2" number={index + 1} />)}</div>
    </section>

    <section class="shell journal-invite zen-card" aria-labelledby="journal-invite-title">
      <h2 id="journal-invite-title">{en ? 'Carrying something you can’t find here?' : 'Đang mang một điều chưa tìm thấy ở đây?'}</h2>
      <p>{en ? 'Send us a few lines about what you are going through or what you would like to read. We read every message and may write about it in a future piece, without your name.' : 'Gửi cho tụi mình vài dòng về điều bạn đang trải qua hoặc chủ đề bạn muốn đọc. Tụi mình đọc từng lời nhắn, và có thể viết thành một bài sau này, không kèm tên bạn.'}</p>
      <a class="button" href={contactPath(lang)}>{en ? 'Send a message' : 'Gửi lời nhắn'} <Arrow /></a>
    </section>
  </main>
  <Footer {lang} />
</BaseLayout>
<script>
  import '../../../scripts/journal-filter';
</script>
