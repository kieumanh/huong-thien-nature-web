---
import Arrow from '../../../components/Arrow.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { languages, getCopy, type Language } from '../../../data/site';
import { articles, articlePath, journalPath, type Article } from '../../../data/articles';

export function getStaticPaths() {
  return languages.flatMap(lang => articles.map(article => ({
    params: { lang, journal: lang === 'vi' ? 'tan-van' : 'journal', slug: articlePath(lang, article.slug).split('/').filter(Boolean).at(-1) }, props: { article },
  })));
}
const lang = Astro.params.lang as Language;
const { article } = Astro.props as { article: Article };
const t = getCopy(lang);
const content = article.translations[lang];
const alternatePath = articlePath(lang === 'vi' ? 'en' : 'vi', article.slug);
const related = articles.filter(item => item.slug !== article.slug);
---
<BaseLayout lang={lang} title={`${content.title} | Hương Thiền Nature`} description={content.description} alternatePath={alternatePath} image={article.image}>
  <Header lang={lang} alternatePath={alternatePath} isInnerPage />
  <main id="main-content" tabindex="-1">
    <article class="article-page">
      <header class="article-header shell">
        <nav class="breadcrumbs" aria-label={lang === 'vi' ? 'Đường dẫn' : 'Breadcrumb'}><a href={`/${lang}/`}>{t.home}</a><span aria-hidden="true">/</span><a href={journalPath(lang)}>{t.journalHome}</a></nav>
        <div class="article-meta"><span>{content.category}</span><span>{article.minutes} {t.readTime}</span></div>
        <h1>{content.title}</h1>
        <p class="lead">{content.description}</p>
      </header>
      <div class="shell article-cover"><img src={article.image} alt={content.imageAlt} width="720" height="540" fetchpriority="high" /></div>
      <div class="article-body">
        <p class="article-introduction">{content.introduction}</p>
        {content.sections.map(section => <section><h2>{section.title}</h2>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}</section>)}
        <aside class="article-practice"><span class="eyebrow">{lang === 'vi' ? 'Mang vào đời sống' : 'Bring it into daily life'}</span><h2>{content.practice.title}</h2><ol>{content.practice.steps.map(step => <li>{step}</li>)}</ol></aside>
        <p class="article-note">{content.note}</p>
        <a class="quiet-link" href={journalPath(lang)}><span aria-hidden="true">←</span> {lang === 'vi' ? 'Trở về tản văn' : 'Back to the journal'}</a>
      </div>
    </article>
    <section class="section related-articles shell" aria-labelledby="related-title"><span class="eyebrow">{t.journalHome}</span><h2 id="related-title">{t.related}</h2><div class="related-grid">{related.map(item => <article class="related-card"><span class="article-meta">{item.translations[lang].category}</span><h3><a href={articlePath(lang, item.slug)}>{item.translations[lang].title}</a></h3><p>{item.translations[lang].description}</p><a class="quiet-link" href={articlePath(lang, item.slug)} aria-label={`${t.journalLink}: ${item.translations[lang].title}`}>{t.journalLink} <Arrow /></a></article>)}</div></section>
  </main>
  <Footer lang={lang} />
</BaseLayout>
