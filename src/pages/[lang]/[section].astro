---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ContemplativeScene from '../../components/ContemplativeScene.astro';
import FounderJourney from '../../components/FounderJourney.astro';
import CourseCatalogue from '../../components/CourseCatalogue.astro';
import StudentFeedback from '../../components/StudentFeedback.astro';
import AlbumGallery from '../../components/AlbumGallery.astro';
import AlbumStrip from '../../components/AlbumStrip.astro';
import TeamProfiles from '../../components/TeamProfiles.astro';
import EcosystemIllustration from '../../components/EcosystemIllustration.astro';
import { ecosystemVision } from '../../data/ecosystem-vision';
import { articlePath } from '../../data/articles';
import { beginnerArticles } from '../../data/home';
import { contactPath } from '../../data/contact-channels';
import { ecosystemPartnerJourney, journeyPageKeys, journeyPages, journeyPath, type JourneyPage } from '../../data/journey-pages';
import { getCopy, languages, type Language } from '../../data/site';
import '../../styles/story-home.css';
import '../../styles/material-home.css';
import '../../styles/journey-pages.css';

export function getStaticPaths() {
  return languages.flatMap(lang => journeyPageKeys.map(page => ({
    params: { lang, section: journeyPages[page][lang].slug }, props: { page },
  })));
}
const { page } = Astro.props as { page: JourneyPage };
const lang = Astro.params.lang as Language;
const vi = lang === 'vi';
const t = getCopy(lang);
const info = journeyPages[page][lang];
const alternatePath = journeyPath(vi ? 'en' : 'vi', page);
const vision = ecosystemVision[lang];
---
<BaseLayout {lang} title={`${info.heading} | Hương Thiền Nature`} description={info.description} {alternatePath}
  pageType={page === 'team' || page === 'story' ? 'AboutPage' : 'WebPage'}
  aboutOrganization={page !== 'practice'}>
  <Header {lang} {alternatePath} />
  <main id="main-content" class="shell journey-page" tabindex="-1">
    <header class="journey-page-header">
      <ContemplativeScene motif="mandala" />
      <Breadcrumb {lang} current={info.title} />
      <div class="journey-page-lead">
        <h1>{info.heading}</h1>
        <p class="lead">{info.description}</p>
      </div>
    </header>

    {page === 'guidance' && <CourseCatalogue {lang} />}

    {page === 'feedback' && <div class="journey-section"><StudentFeedback {lang} hideHead /></div>}

    {page === 'album' && <AlbumGallery {lang} />}

    {page === 'practice' && <>
      <section class="material-practice" id="practice" aria-labelledby="practice-title">
        <div class="material-practice__copy">
          <p class="eyebrow">{t.practiceEye}</p>
          <h2 id="practice-title">{vi ? 'Trở về với hơi thở' : 'Return to your breath'}</h2>
          <p>{t.practiceCopy}</p>
          <ol class="material-steps">{t.steps.map(([, title, description]) => <li><strong>{title}</strong><p>{description}</p></li>)}</ol>
          <a class="quiet-link" href={articlePath(lang, 'returning-attention')}>{vi ? 'Đọc hướng dẫn thực tập' : 'Read the practice guide'}</a>
        </div>
        <figure class="material-yoga">
          <ContemplativeScene motif="yoga" />
          <figcaption><a href="https://pixabay.com/photos/yoga-pose-exercise-woman-female-3426151/">{vi ? 'Ảnh yoga trên Pixabay' : 'Yoga photograph on Pixabay'}</a></figcaption>
        </figure>
      </section>
      <section class="journey-section">
        <h2>{vi ? 'Nên đọc bài nào khi mới tập?' : 'What should I read first?'}</h2>
        <p>{vi ? 'Bắt đầu với cách chọn tư thế và chuẩn bị buổi đầu tiên. Khi đã quen với chỗ ngồi, thử quan sát hơi thở theo từng bước.' : 'Begin with a posture you can settle into and prepare for a first sitting. Once you feel at ease, try observing the breath step by step.'}</p>
        <ol class="journey-reading-list">{beginnerArticles.map(article => <li><a class="quiet-link" href={articlePath(lang, article.slug)}>{article.translations[lang].title}</a></li>)}</ol>
        <a class="quiet-link" href={articlePath(lang, 'when-meditation-is-difficult')}>{vi ? 'Làm gì khi thấy khó ngồi thiền?' : 'What can I do when meditation feels difficult?'}</a>
      </section>
      <AlbumStrip {lang} id="quiet-moments" photos={['beach-meditate-calm', 'altar-flowers', 'plaque-moon-boat', 'plaque-monk-branch']}
        title={vi ? 'Những phút lắng lại' : 'Moments of stillness'}
        intro={vi ? 'Một bãi biển, một góc bàn nhỏ, vài phút ngồi yên: không cần nơi nào đặc biệt để bắt đầu.' : 'A beach, a small table corner, a few minutes of sitting still: you do not need a special place to begin.'} />
    </>}

    {page === 'ecosystem' && <>
      <section class="journey-section" id="nature" aria-labelledby="vision-title">
        <h2 id="vision-title">{vision.question}</h2>
        <p>{vision.introduction}</p>
        <EcosystemIllustration {...vision.loop} variant="loop" />
      </section>
      <section class="journey-section" aria-labelledby="directions-title">
        <h2 id="directions-title">{vision.pathsTitle}</h2>
        <div class="vision-grid">
          {vision.paths.map((path, index) => <article class="zen-card vision-card">
            <h3>{path.title}</h3>
            <p><strong>{path.focus}</strong></p>
            <p>{path.text}</p>
            {index === 0 && <a class="quiet-link" href="#partnerships">{vi ? 'Gặp đối tác nông nghiệp' : 'Meet our farming partner'}</a>}
          </article>)}
        </div>
      </section>
      <AlbumStrip {lang} id="garden-moments" photos={['veggie-bed-trellis', 'wooden-house', 'flowers-red-path', 'toddler-squat']}
        title={vi ? 'Từ khu vườn Gửi Yêu Thương Vào Đất' : 'From the Gửi Yêu Thương Vào Đất garden'}
        intro={vi ? 'Hình ảnh thật từ khu vườn của dự án hợp tác Farm Gửi Yêu Thương Vào Đất cùng anh Lê Lam Sơn: luống rau, giàn tre, căn nhà gỗ và lối đất đỏ.' : 'Real photographs from the garden of the Gửi Yêu Thương Vào Đất Farm collaboration with Lê Lam Sơn: vegetable beds, bamboo trellises, a timber house and a red-earth path.'} />
      <section class="journey-section" id="partnerships" aria-labelledby="partnerships-title">
        <h2 id="partnerships-title">{vi ? 'Hành trình kết nối đối tác' : 'How our partnerships took shape'}</h2>
        <p>{vi ? 'Hai mối hợp tác giúp Hương Thiền Nature đưa việc chăm đất, sống xanh và kinh nghiệm của những người đồng hành vào thực tế.' : 'Two partnerships bring natural farming, greener living and the experience of trusted advisers into Hương Thiền Nature.'}</p>
        <div class="partner-journey-grid">
          {ecosystemPartnerJourney.map(({ partner, date, [lang]: entry }) => <article class="zen-card vision-card">
            <p class="eyebrow">{date ? <time datetime={date}>{entry.milestone}</time> : entry.milestone}</p>
            <h3>{partner.name}</h3>
            <p><strong>{entry.affiliation}</strong></p>
            <p>{entry.description}</p>
            <a class="quiet-link" href={partner.site}>{partner.label}</a>
          </article>)}
        </div>
      </section>
      <section class="journey-section" aria-labelledby="advantages-title">
        <h2 id="advantages-title">{vision.advantagesTitle}</h2>
        <dl class="vision-principles">{vision.advantages.map(([title, detail]) => <div><dt>{title}</dt><dd>{detail}</dd></div>)}</dl>
      </section>
      <section class="journey-section" id="path" aria-label={vision.roadmap.title}>
        <EcosystemIllustration {...vision.roadmap} variant="roadmap" />
        <p>{t.natureNote}</p>
        <a class="quiet-link" href={`/${lang}/#nature`}>{vi ? 'Xem ba quỹ đạo trên trang chủ' : 'See the three orbits on the homepage'}</a>
      </section>
    </>}

    {page === 'story' && <>
      <section class="journey-section" id="story">
        <h2>{t.introTitle}</h2>
        <p>{t.introCopy}</p>
      </section>
      <FounderJourney {lang} />
      <AlbumStrip {lang} id="journey-moments" photos={['event-banner', 'studio-hug-six', 'hug-closeup']}
        title={vi ? 'Trên những chặng gặp gỡ và chia sẻ' : 'Along the way: meeting and sharing'}
        intro={vi ? 'Một vài hình ảnh từ chuyến chia sẻ ở Nha Trang. Phần còn lại của hành trình nằm trong album.' : 'A few photographs from a sharing trip in Nha Trang. The rest of the journey is in the album.'} />
      <a class="quiet-link" href={journeyPath(lang, 'team')}>{vi ? 'Gặp đội ngũ Hương Thiền Nature' : 'Meet the Hương Thiền Nature team'}</a>
    </>}

    {page === 'team' && <>
      <TeamProfiles {lang} />
      <p class="team-contact"><a class="button" href={contactPath(lang)}>{vi ? 'Liên hệ đội ngũ' : 'Contact the team'}</a></p>
    </>}
  </main>
  <Footer {lang} />
</BaseLayout>
