---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ContemplativeScene from '../../components/ContemplativeScene.astro';
import FounderJourney from '../../components/FounderJourney.astro';
import CourseCatalogue from '../../components/CourseCatalogue.astro';
import StudentFeedback from '../../components/StudentFeedback.astro';
import SupportFund from '../../components/SupportFund.astro';
import { supportShareImage } from '../../data/support-fund';
import AlbumGallery from '../../components/AlbumGallery.astro';
import AlbumStrip from '../../components/AlbumStrip.astro';
import BreathGuide from '../../components/BreathGuide.astro';
import TeamProfiles from '../../components/TeamProfiles.astro';
import EcosystemIllustration from '../../components/EcosystemIllustration.astro';
import EcosystemWhy from '../../components/EcosystemWhy.astro';
import EcosystemHero from '../../components/EcosystemHero.astro';
import LandingMotion from '../../components/LandingMotion.astro';
import AlbumImage from '../../components/AlbumImage.astro';
import AnimatedIcon, { type IconName } from '../../components/AnimatedIcon.astro';
import '../../styles/landing.css';
import { ecosystemVision } from '../../data/ecosystem-vision';
import { articlePath, journalPath } from '../../data/articles';
import { themeById, themePath } from '../../data/shop-themes';
import Arrow from '../../components/Arrow.astro';
import { practicePath } from '../../data/home';
import { contactPath } from '../../data/contact-channels';
import { ecosystemPartnerJourney, journeyPageKeys, journeyPages, journeyPath, type JourneyPage } from '../../data/journey-pages';
import { getCopy, languages, type Language } from '../../data/site';
import '../../styles/story-home.css';
import '../../styles/material-home.css';
import '../../styles/journey-pages.css';

export function getStaticPaths() {
  return languages.flatMap(lang => journeyPageKeys.map(page => ({
    params: { lang, section: journeyPages[page][lang].slug }, props: { page },
  })));
}
const { page } = Astro.props as { page: JourneyPage };
const lang = Astro.params.lang as Language;
const vi = lang === 'vi';
const t = getCopy(lang);
const info = journeyPages[page][lang];
const alternatePath = journeyPath(vi ? 'en' : 'vi', page);
const vision = ecosystemVision[lang];
// Each focal point carries the icon of its pillar (the order of the cards is decorative, not a sequence).
const focusIcons = { 'phap-mon': 'meditation', 'thien-nhien': 'seed', 'ho-tro': 'mind' } as const;
const ecoLinks: Record<string, string> = {
  guidance: journeyPath(lang, 'guidance'), practice: journeyPath(lang, 'practice'), partnerships: '#partnerships',
  food: themePath(lang, themeById('thuc-pham-sach')!), stones: themePath(lang, themeById('da-nang-luong')!), journal: journalPath(lang),
};
// Photographs of the three focal points: [album id, object-position] for the main picture and the small round one.
const focusPhotos: Record<string, { main: [string, string]; side: [string, string] }> = {
  'phap-mon': { main: ['park-heart-hands', '50% 45%'], side: ['prayer-hands-seashore', '50% 40%'] },
  'thien-nhien': { main: ['wooden-house', '50% 55%'], side: ['cabbage-rows-red-soil', '40% 60%'] },
  'ho-tro': { main: ['tarot-decks', '50% 50%'], side: ['plaque-lotus-leaf', '50% 35%'] },
};
const partnerIcons: Record<string, IconName> = { 'Lê Lam Sơn': 'sprout', 'Nguyễn Trần Quyết': 'gem', ZenWork: 'wave' };
const partnerTones: Record<string, string> = { 'Nguyễn Trần Quyết': 'landing-icon--gold', ZenWork: 'landing-icon--orchid' };
import LivingZenValues from '../../components/LivingZenValues.astro';
import PillarIcon from '../../components/PillarIcon.astro';
---
<BaseLayout {lang} title={`${info.heading} | Hương Thiền Nature`} description={info.description} {alternatePath}
  {...(page === 'support' ? { image: supportShareImage[lang].src, imageDetails: { type: supportShareImage.type, width: supportShareImage.width, height: supportShareImage.height, alt: supportShareImage[lang].alt } } : {})}
  pageType={page === 'team' || page === 'story' ? 'AboutPage' : 'WebPage'}
  aboutOrganization={page !== 'practice'}>
  <Header {lang} {alternatePath} />
  <main id="main-content" class:list={['shell journey-page', { 'landing-eco': page === 'ecosystem' }]} tabindex="-1">
    {page === 'ecosystem' ? <EcosystemHero {lang} title={info.heading} current={info.title} /> : <header class="journey-page-header">
      <ContemplativeScene motif="mandala" />
      <Breadcrumb {lang} current={info.title} />
      <div class="journey-page-lead">
        <h1>{info.heading}</h1>
        <p class="lead">{info.description}</p>
      </div>
    </header>}

    {page === 'guidance' && <CourseCatalogue {lang} />}

    {page === 'feedback' && <div class="journey-section"><StudentFeedback {lang} hideHead /></div>}

    {page === 'album' && <AlbumGallery {lang} />}

    {page === 'support' && <>
      <SupportFund {lang} />
      <AlbumStrip {lang} id="support-moments" photos={['beach-dance', 'beach-selfie', 'painting-tree']}
        title={vi ? 'Những điều nhỏ bé được nuôi lớn' : 'Small things, nourished to grow'}
        intro={vi ? 'Sự đồng hành của bạn giúp những khoảnh khắc bình yên như thế này được lan tỏa.' : 'Your support helps peaceful moments like these reach more people.'} />
    </>}

    {page === 'practice' && <>
      <nav class="practice-jump" aria-label={vi ? 'Đi nhanh tới mục' : 'Jump to a section'}>
        <a href="#practice">{vi ? '1 · Trở về hơi thở' : '1 · Return to the breath'}</a>
        <a href="#start-reading">{vi ? '2 · Bài nên đọc' : '2 · Where to read'}</a>
        <a href="#quiet-moments">{vi ? '3 · Phút lắng lại' : '3 · Moments of stillness'}</a>
      </nav>
      <section class="material-practice" id="practice" aria-labelledby="practice-title">
        <div class="material-practice__copy">
          <p class="eyebrow">{t.practiceEye}</p>
          <h2 id="practice-title">{vi ? 'Trở về với hơi thở' : 'Return to your breath'}</h2>
          <p>{t.practiceCopy}</p>
          <ol class="material-steps">{t.steps.map(([, title, description]) => <li><strong>{title}</strong><p>{description}</p></li>)}</ol>
          <a class="quiet-link" href={articlePath(lang, 'returning-attention')}>{vi ? 'Đọc hướng dẫn thực tập' : 'Read the practice guide'}</a>
        </div>
        <figure class="material-yoga">
          <ContemplativeScene motif="yoga" />
          <figcaption><a href="https://pixabay.com/photos/yoga-pose-exercise-woman-female-3426151/">{vi ? 'Ảnh yoga trên Pixabay' : 'Yoga photograph on Pixabay'}</a></figcaption>
        </figure>
      </section>
      <div class="journey-section"><BreathGuide {lang} /></div>
      <section class="journey-section practice-reading" id="start-reading" aria-labelledby="start-reading-title">
        <h2 id="start-reading-title">{vi ? 'Nên đọc bài nào khi mới tập?' : 'What should I read first?'}</h2>
        <p>{vi ? 'Bắt đầu với cách chọn tư thế và chuẩn bị buổi đầu tiên. Khi đã quen với chỗ ngồi, thử quan sát hơi thở theo từng bước.' : 'Begin with a posture you can settle into and prepare for a first sitting. Once you feel at ease, try observing the breath step by step.'}</p>
        <ol class="practice-path">{practicePath(lang).map((step, index) => <li class="practice-path__item zen-card">
          <span class="practice-path__number" aria-hidden="true">{index + 1}</span>
          <div>
            <p class="practice-path__meta">{vi ? `Bước ${index + 1}` : `Step ${index + 1}`} · {vi ? step.article.minutesVi ?? step.article.minutes : step.article.minutes} {getCopy(lang).readTime}</p>
            <h3><a href={articlePath(lang, step.article.slug)}>{step.title}</a></h3>
            <p>{step.description}</p>
          </div>
        </li>)}</ol>
      </section>
      <AlbumStrip {lang} id="quiet-moments" photos={['beach-meditate-calm', 'altar-flowers', 'plaque-moon-boat', 'plaque-monk-branch']}
        title={vi ? 'Những phút lắng lại' : 'Moments of stillness'}
        intro={vi ? 'Một bãi biển, một góc bàn nhỏ, vài phút ngồi yên: không cần nơi nào đặc biệt để bắt đầu.' : 'A beach, a small table corner, a few minutes of sitting still: you do not need a special place to begin.'} />
      <section class="journey-section practice-next zen-card" aria-labelledby="practice-next-title">
        <h2 id="practice-next-title">{vi ? 'Khi bạn muốn có người đi cùng' : 'When you would like company on the way'}</h2>
        <p>{vi ? 'Tự thực hành là một khởi đầu đẹp. Nếu bạn muốn được hướng dẫn từng bước hoặc có người lắng nghe, các khóa thực hành luôn mở cửa, không ép buộc.' : 'Practising alone is a lovely beginning. If you would like step-by-step guidance or someone to listen, the practice courses are there, with no pressure.'}</p>
        <p class="practice-next__links"><a class="button" href={journeyPath(lang, 'guidance')}>{vi ? 'Xem khóa thực hành' : 'See the practice courses'}</a> <a class="quiet-link" href={contactPath(lang)}>{vi ? 'Hoặc nhắn tin cho tụi mình' : 'Or send us a message'}</a></p>
      </section>
    </>}

    {page === 'ecosystem' && <>
      <section class="journey-section eco-intro" id="eco-intro" aria-labelledby="eco-focus-title">
        <div class="landing-head" data-reveal="up">
          <span class="landing-icon landing-icon--gold landing-icon--large" aria-hidden="true"><AnimatedIcon name="sprout" /></span>
          <h2 id="eco-focus-title">{vision.focusTitle}</h2>
          <p class="lead eco-intro__lead">{vision.intro}</p>
        </div>
        <ol class="eco-focus-list">
          {vision.focus.map((item, index) => <li class={`eco-focus zen-card eco-focus--${index + 1}`} id={item.id}>
            <div class="eco-focus__media" data-reveal="fade">
              <figure class="eco-focus__photo eco-focus__photo--main" style={`--pp:${focusPhotos[item.id].main[1]}`}><AlbumImage id={focusPhotos[item.id].main[0]} {lang} sizes="(min-width: 860px) 52vw, 92vw" /></figure>
              <figure class="eco-focus__photo eco-focus__photo--side" style={`--pp:${focusPhotos[item.id].side[1]}`}><AlbumImage id={focusPhotos[item.id].side[0]} {lang} sizes="(min-width: 860px) 18vw, 32vw" /></figure>
            </div>
            <div class="eco-focus__body" data-reveal="up">
              <span class="eco-focus__number" aria-hidden="true"><PillarIcon name={focusIcons[item.id as keyof typeof focusIcons]} /></span>
              <p class="eco-focus__tagline">{item.tagline}</p>
              <h3>{item.title}</h3>
              <p class="eco-focus__text">{item.short}</p>
              <p class="eco-focus__links">{item.links.map(([key, label]) => <a class="quiet-link" href={ecoLinks[key]}>{label} <Arrow /></a>)}</p>
            </div>
          </li>)}
        </ol>
        <p class="eco-note">{vision.note}</p>
      </section>
      <section class="journey-section" aria-labelledby="eco-loop-title">
        <h2 id="eco-loop-title" class="sr-only">{vision.loop.title}</h2>
        <EcosystemIllustration {...vision.loop} variant="loop" />
      </section>
      <EcosystemWhy {lang} />
      <LivingZenValues {lang} variant="full" id="living-zen" />
      <AlbumStrip {lang} id="garden-moments" balanced photos={['banana-grove-house', 'seedling-coconut-shell', 'flowers-red-path', 'veggie-sunset']}
        title={vi ? 'Từ khu vườn Gửi Yêu Thương Vào Đất' : 'From the Gửi Yêu Thương Vào Đất garden'}
        intro={vi ? 'Hình thật từ khu vườn của dự án hợp tác Farm Gửi Yêu Thương Vào Đất cùng anh Lê Lam Sơn.' : 'Real photographs from the garden of the Gửi Yêu Thương Vào Đất Farm collaboration with Lê Lam Sơn.'} />
      <section class="journey-section" id="partnerships" aria-labelledby="partnerships-title">
        <div class="landing-head" data-reveal="up">
          <h2 id="partnerships-title">{vision.partnersTitle}</h2>
        </div>
        <div class="partner-journey-grid">
          {ecosystemPartnerJourney.map(({ partner, date, [lang]: entry }) => <article class="zen-card vision-card eco-partner" data-reveal="fade">
            <span class={`landing-icon ${partnerTones[partner.name] ?? ''}`} aria-hidden="true"><AnimatedIcon name={partnerIcons[partner.name] ?? 'leaf'} /></span>
            <p class="eyebrow">{date ? <time datetime={date}>{entry.milestone}</time> : entry.milestone}</p>
            <h3>{partner.name}</h3>
            <p class="partner-card__name">{entry.affiliation}</p>
            <p class="eco-supports">{(vision.supports as Record<string, string>)[partner.name]}</p>
            <a class="partner-card__site" href={partner.site}><span>{partner.label}</span><Arrow /></a>
          </article>)}
        </div>
        <p class="eco-partners__more"><a class="quiet-link" href={`${journeyPath(lang, 'team')}#doi-tac`}>{vi ? 'Đọc về từng người đồng hành' : 'Read about each partner'} <Arrow /></a></p>
      </section>
      <section class="journey-section eco-closing" aria-labelledby="eco-closing-title">
        <figure class="eco-closing__art" data-reveal="fade"><AlbumImage id="beach-palms" {lang} sizes="(min-width: 860px) 44rem, 92vw" /></figure>
        <h2 id="eco-closing-title" data-reveal="up">{vision.closingTitle}</h2>
        <p class="eco-closing__text" data-reveal="up">{vision.closing}</p>
        <EcosystemIllustration {...vision.start} variant="roadmap" />
      </section>
      <section class="journey-section eco-cta zen-card" aria-labelledby="eco-cta-title">
        <h2 id="eco-cta-title">{vision.cta.title}</h2>
        <p>{vision.cta.text}</p>
        <p class="eco-cta__actions"><a class="button" href={contactPath(lang)}>{vision.cta.action} <Arrow /></a> <a class="quiet-link" href={`/${lang}/#nature`}>{vi ? 'Xem tóm tắt trên trang chủ' : 'See the summary on the home page'}</a></p>
      </section>
    </>}

    {page === 'story' && <>
      <section class="journey-section" id="story">
        <h2>{t.introTitle}</h2>
        <p>{t.introCopy}</p>
      </section>
      <FounderJourney {lang} />
      <AlbumStrip {lang} id="journey-moments" balanced photos={['event-banner', 'studio-group', 'hug-closeup', 'studio-hug-six']}
        title={vi ? 'Trên những chặng gặp gỡ và chia sẻ' : 'Along the way: meeting and sharing'}
        intro={vi ? 'Một vài hình ảnh từ chuyến chia sẻ ở Nha Trang. Phần còn lại của hành trình nằm trong album.' : 'A few photographs from a sharing trip in Nha Trang. The rest of the journey is in the album.'} />
      <p class="story-team-cta">
        <a class="button button--tonal" href={journeyPath(lang, 'team')}>{vi ? 'Gặp đội ngũ Hương Thiền Nature' : 'Meet the Hương Thiền Nature team'} <Arrow /></a>
      </p>
    </>}

    {page === 'team' && <>
      <TeamProfiles {lang} />
      <p class="team-contact"><a class="button" href={contactPath(lang)}>{vi ? 'Liên hệ đội ngũ' : 'Contact the team'}</a></p>
    </>}
  </main>
  <Footer {lang} />
  {page === 'ecosystem' && <LandingMotion />}
</BaseLayout>
