---
import { contactPath } from '../../data/contact-channels';
import HomePhoto from '../../components/HomePhoto.astro';
import EcosystemOrbit from '../../components/EcosystemOrbit.astro';
import HomeDiscovery from '../../components/HomeDiscovery.astro';
import { homeCopy, featuredArticles } from '../../data/home';
import RiceLandscapes from '../../components/RiceLandscapes.astro';
import FounderJourney from '../../components/FounderJourney.astro';
import ContemplativeScene from '../../components/ContemplativeScene.astro';
import '../../styles/story-home.css';
import '../../styles/hybrid-nature.css';
import '../../styles/material-home.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { languages, getCopy, type Language } from '../../data/site';
import { articlePath, journalPath } from '../../data/articles';
import { shopPath } from '../../data/products';

export function getStaticPaths() {
  return languages.map(lang => ({ params: { lang } }));
}
const lang = Astro.params.lang as Language;
const en = lang === 'en';
const t = getCopy(lang);
const home = homeCopy[lang];
const alternatePath = `/${en ? 'vi' : 'en'}/`;
const natureImages = ['roots-garden.webp', 'vietnam-rice-fields.jpg', 'farmer-field.jpg'];
const ecosystemLinks = [
  [shopPath(lang), en ? 'Browse the shop' : 'Xem cửa hàng'],
  [articlePath(lang, 'listening-to-nature'), en ? 'Try a mindful walk' : 'Thử đi bộ chánh niệm'],
  [journalPath(lang), en ? 'Explore the journal' : 'Khám phá Tản văn'],
];
const founders = [
  ['Hương Thiền', '/media/home-mountain-lake.webp', t.founderRole, t.founderCopy],
  ['Kiều Mạnh', '/media/author-kieu-manh.jpg', t.coRole, t.coCopy],
];
---
<BaseLayout lang={lang} title={`${t.title} | Hương Thiền Nature`} description={t.desc} alternatePath={alternatePath}>
  <Header lang={lang} alternatePath={alternatePath} />
  <main id="main-content" class="material-home" tabindex="-1">
    <section class="shell material-hero" aria-labelledby="hero-title">
      <div class="material-hero__copy">
        <span class="eyebrow">{t.eyebrow}</span>
        <h1 id="hero-title" set:html={t.hero} />
        <p class="lead">{en ? 'Explore meditation, mindfulness and simple ways to live closer to nature.' : 'Khám phá thiền định, chánh niệm và những cách giản dị để sống gần gũi hơn với thiên nhiên.'}</p>
        <div class="material-actions">
          <a class="button" href="#practice">{en ? 'Practise for one minute' : 'Thực tập một phút'}</a>
          <a class="button button--tonal" href={journalPath(lang)}>{en ? 'Read the journal' : 'Đọc Tản văn'}</a>
        </div>
      </div>
      <ContemplativeScene motif="meditation" />
    </section>

    <section class="shell material-block" id="practice" aria-labelledby="practice-title">
      <div class="material-practice">
        <div class="material-practice__copy">
          <span class="eyebrow">{t.practiceEye}</span>
          <h2 id="practice-title">{en ? 'Return to your breath' : 'Trở về với hơi thở'}</h2>
          <ol class="material-steps">{t.steps.map(([, title, description]) => <li><strong>{title}</strong><p>{description}</p></li>)}</ol>
          <a class="quiet-link" href={articlePath(lang, 'returning-attention')}>{en ? 'Read the practice guide' : 'Đọc hướng dẫn thực tập'}</a>
        </div>
        <figure class="material-yoga">
          <ContemplativeScene motif="yoga" />
          <figcaption><a href="https://pixabay.com/photos/yoga-pose-exercise-woman-female-3426151/">{en ? 'Yoga photograph on Pixabay' : 'Ảnh yoga trên Pixabay'}</a></figcaption>
        </figure>
      </div>
    </section>

    <HomeDiscovery lang={lang} />

    <section id="journal" class="shell material-block" aria-labelledby="journal-title">
      <div class="material-section-heading">
        <h2 id="journal-title">{home.featuredTitle}</h2>
        <a class="button button--tonal" href={journalPath(lang)}>{en ? 'All articles' : 'Tất cả bài viết'}</a>
      </div>
      <div class="journal-grid">{featuredArticles.map(article => {
        const translation = article.translations[lang];
        const href = articlePath(lang, article.slug);
        return (
          <article class="journal-card material-reading-card">
            <img src={article.image} alt="" width="720" height="540" loading="lazy" />
            <div class="journal-card-copy">
              <div class="article-meta"><span>{translation.category}</span><span>{(en ? article.minutes : article.minutesVi ?? article.minutes)} {t.readTime}</span></div>
              <h3><a href={href}>{translation.title}</a></h3>
              <p>{translation.description}</p>
            </div>
          </article>
        );
      })}</div>
      <p id="layers" class="material-inline-link"><a class="quiet-link" href={articlePath(lang, 'seven-layers')}>{en ? 'Explore the seven-layer framework' : 'Tìm hiểu khung chiêm nghiệm bảy tầng'}</a></p>
    </section>

    <section id="nature" class="shell material-block material-ecosystem" aria-labelledby="nature-title">
      <div class="material-section-heading"><h2 id="nature-title">{en ? 'The Hương Thiền ecosystem' : 'Hệ sinh thái Hương Thiền'}</h2></div>
      <EcosystemOrbit lang={lang} cards={t.natureCards} images={natureImages} links={ecosystemLinks} />
      <p class="material-ecosystem__note">{t.natureNote}</p>
      <details class="material-details">
        <summary>{en ? 'Photographs from nature and everyday life' : 'Ảnh thiên nhiên và đời sống'}</summary>
        <div class="nature-photos">
          <figure class="nature-photos__outdoor-kitchen"><HomePhoto photo="outdoor-kitchen" {lang} /><figcaption>{en ? 'Preparing a meal outdoors' : 'Sửa soạn bữa ăn bên bếp củi'}</figcaption></figure>
          <figure><HomePhoto photo="together-by-sea" {lang} /><figcaption>{en ? 'A moment together by the sea' : 'Một khoảnh khắc bên nhau ngoài biển'}</figcaption></figure>
        </div>
        <RiceLandscapes lang={lang} />
      </details>
    </section>

    <section id="story" class="shell material-block" aria-labelledby="people-title">
      <div id="people" class="material-section-heading"><h2 id="people-title">{t.peopleTitle}</h2></div>
      <div class="material-founders">
        {founders.map(([name, photo, role, copy]) => (
          <article class="material-founder">
            <span class:list={['material-founder__portrait', { 'material-founder__portrait--closer': name === 'Kiều Mạnh' }]}><img src={photo} alt="" width="128" height="128" loading="lazy" /></span>
            <div><h3>{name}</h3><p class="material-founder__role">{role}</p><p>{copy}</p></div>
          </article>
        ))}
      </div>
      <FounderJourney lang={lang} />
    </section>

    <section id="connect" class="shell material-block material-contact" aria-labelledby="connect-title">
      <div class="material-contact__intro">
        <div><h2 id="connect-title">{t.contactTitle}</h2><p>{en ? 'Write to us about practice, the shop or upcoming activities.' : 'Bạn có thể hỏi về việc thực tập, sản phẩm hoặc những hoạt động sắp tới.'}</p></div>
        <a class="button" href={contactPath(lang)}>{en ? 'Contact us' : 'Liên hệ'}</a>
      </div>
      <details class="material-details" id="path">
        <summary>{t.phasesTitle}</summary>
        <dl class="material-roadmap">{t.phases.map(([, title, description]) => <div><dt>{title}</dt><dd>{description}</dd></div>)}</dl>
      </details>
      <details class="material-details">
        <summary>{en ? 'What can I join right now?' : 'Hiện tại mình có thể tham gia gì?'}</summary>
        <p class="material-details__body">{en ? 'You can read the bilingual journal, try the introductory practices and browse the shop. Course and retreat dates will be announced when available.' : 'Bạn có thể đọc Tản văn, thử các bài thiền nhập môn và ghé Cửa hàng. Khóa học và kỳ nghỉ thực tập sẽ được thông báo khi có lịch.'}</p>
      </details>
    </section>
  </main>
  <Footer lang={lang} />
  <script>
    const openSection = () => {
      const target = document.getElementById(location.hash.slice(1));
      if (!target) return;
      for (let element: HTMLElement | null = target; element; element = element.parentElement) {
        if (element instanceof HTMLDetailsElement) element.open = true;
      }
      target.scrollIntoView();
    };
    window.addEventListener('hashchange', openSection);
    openSection();
  </script>
</BaseLayout>
