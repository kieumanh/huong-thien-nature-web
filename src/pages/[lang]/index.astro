---
import Arrow from '../../components/Arrow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RootMark from '../../components/RootMark.astro';
import { languages, getCopy, type Language } from '../../data/site';
import { articles, articlePath } from '../../data/articles';

export function getStaticPaths() {
  return languages.map(lang => ({ params: { lang } }));
}
const lang = Astro.params.lang as Language;
const en = lang === 'en';
const t = getCopy(lang);
const alternatePath = `/${en ? 'vi' : 'en'}/`;
const natureImages = ['fern-study-v2.webp', 'woodland-stream-v2.webp', 'hero-canopy-v2.webp'];
---
<BaseLayout lang={lang} title={`${t.title} | Hương Thiền Nature`} description={t.desc} alternatePath={alternatePath}>
  <Header lang={lang} alternatePath={alternatePath} />
  <main id="main-content" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">{t.eyebrow}</span>
          <h1 id="hero-title" set:html={t.hero} />
          <p class="lead">{t.lead}</p>
          <div class="hero-actions">
            <a class="button" href="#practice">{t.explore} <Arrow /></a>
            <a class="quiet-link" href="#story">{t.storyCta} <span aria-hidden="true">→</span></a>
          </div>
          <div class="hero-footnote"><span class="small-dot" aria-hidden="true"></span><p>{t.note}</p></div>
        </div>
        <div class="hero-art">
          <img class="hero-image" src="/media/hero-canopy-v2.webp" alt={en ? 'A winding path beneath a green woodland canopy.' : 'Con đường uốn qua những tán cây xanh trong rừng.'} width="720" height="480" fetchpriority="high" />
          <div class="hero-art-label"><span>Hương Thiền Nature</span><span>{en ? 'A living practice' : 'Một thực tập sống động'}</span></div>
          <div class="root-seal" aria-hidden="true"><RootMark /></div>
        </div>
      </div>
      <div class="shell hero-bottom"><span>{t.rootsNote}</span><a href="#story">{en ? 'Explore at your own pace' : 'Khám phá theo nhịp của bạn'} <span aria-hidden="true">↓</span></a></div>
    </section>

    <section id="story" class="section roots" aria-labelledby="story-title">
      <div class="shell">
        <div class="intro-grid">
          <div class="intro-side"><span class="eyebrow">{t.introEyebrow}</span><RootMark class="intro-root" /><p class="intro-mark">{t.introMark}</p></div>
          <div class="intro-copy"><h2 id="story-title">{t.introTitle}</h2><p class="lead">{t.introCopy}</p><p class="small-copy">{en ? 'No perfect state to reach. Just a little room to notice, to care and to begin again.' : 'Không cần đạt đến một trạng thái hoàn hảo. Chỉ cần một khoảng mở để nhận biết, chăm sóc và bắt đầu lại.'}</p></div>
        </div>
        <div class="three-pillars">
          {t.pillars.map(([n, title, text], index) => <article class="pillar"><span class="index-number">{n}</span><h3>{title}</h3><p>{text}</p><a class="quiet-link" href={index === 2 ? '#nature' : '#practice'} aria-label={`${en ? 'Explore' : 'Khám phá'}: ${title}`}>{en ? 'Explore' : 'Khám phá'} <Arrow /></a></article>)}
        </div>
      </div>
    </section>

    <section id="practice" class="section practice" aria-labelledby="practice-title">
      <div class="shell practice-grid">
        <figure class="practice-image"><img src="/media/practice-cushion-v2.webp" alt={en ? 'A woven meditation cushion in a quiet forest clearing.' : 'Một chiếc đệm thiền trong khoảng rừng yên tĩnh.'} width="720" height="540" loading="lazy" /><figcaption>{t.practiceCaption}</figcaption></figure>
        <div><span class="eyebrow">{t.practiceEye}</span><h2 id="practice-title" set:html={t.practiceTitle} /><p class="lead">{t.practiceCopy}</p><ol class="steps">{t.steps.map(([n, title, text]) => <li><span class="step-number" aria-hidden="true">{n}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol><a class="quiet-link" href={articlePath(lang, 'returning-attention')}>{en ? 'Try a one-minute practice' : 'Thử một phút thực tập'} <Arrow /></a></div>
      </div>
    </section>

    <section id="nature" class="section nature" aria-labelledby="nature-title">
      <div class="shell">
        <div class="section-head split-head"><div><span class="eyebrow">{t.natureEye}</span><h2 id="nature-title">{t.natureTitle}</h2></div><p>{t.natureCopy}</p></div>
        <div class="nature-grid">{t.natureCards.map(([title, text], index) => <article class="nature-card"><div class="nature-image"><img src={`/media/${natureImages[index]}`} alt="" width="720" height={index === 2 ? 480 : 540} loading="lazy" /><span aria-hidden="true">0{index + 1}</span></div><div class="nature-card-copy"><h3>{title}</h3><p>{text}</p></div></article>)}</div>
        <div class="nature-bottom"><p class="note">{t.natureNote}</p><a class="quiet-link" href={articlePath(lang, 'listening-to-nature')}>{en ? 'Take a mindful walk' : 'Một cuộc gặp với thiên nhiên'} <Arrow /></a></div>
      </div>
    </section>

    <section id="people" class="section people" aria-labelledby="people-title">
      <div class="shell people-grid">
        <figure class="portrait-wrap"><img src="/media/huong-thien-founder.webp" alt={en ? 'Hương Thiền, founder of Hương Thiền Nature, in a garden.' : 'Hương Thiền, người sáng lập Hương Thiền Nature, trong khu vườn.'} width="540" height="1200" loading="lazy" /><figcaption>{t.portraitCaption}</figcaption></figure>
        <div><span class="eyebrow">{t.peopleEye}</span><h2 id="people-title">{t.peopleTitle}</h2><div class="people-copy"><article class="person"><span class="role">{t.founderRole}</span><h3>Hương Thiền</h3><p>{t.founderCopy}</p></article><article class="person"><span class="role">{t.coRole}</span><h3>Kiều Mạnh</h3><p>{t.coCopy}</p></article></div></div>
      </div>
    </section>

    <section id="journal" class="section journal" aria-labelledby="journal-title">
      <div class="shell">
        <div class="section-head split-head"><div><span class="eyebrow">{t.journalEye}</span><h2 id="journal-title">{t.journalTitle}</h2></div><p>{t.journalIntro}</p></div>
        <div class="journal-grid">{articles.map(article => {
          const translation = article.translations[lang];
          return <article class="journal-card"><a class="journal-image" href={articlePath(lang, article.slug)} tabindex="-1" aria-hidden="true"><img src={article.image} alt="" width="720" height="540" loading="lazy" /></a><div class="journal-card-copy"><div class="article-meta"><span>{translation.category}</span><span>{article.minutes} {t.readTime}</span></div><h3><a href={articlePath(lang, article.slug)}>{translation.title}</a></h3><p>{translation.description}</p><a class="quiet-link" href={articlePath(lang, article.slug)} aria-label={`${t.journalLink}: ${translation.title}`}>{t.journalLink} <Arrow /></a></div></article>;
        })}</div>
        <aside id="layers" class="reflection-note"><span class="eyebrow">{en ? 'A personal lens' : 'Một góc nhìn cá nhân'}</span><p>{en ? 'The seven-layer framework is a prompt for reflection, not a clinical assessment or a universal scientific map. Each person has room for their own experience.' : 'Bảy tầng là khung chiêm nghiệm cá nhân, không phải công cụ đánh giá lâm sàng hay bản đồ khoa học phổ quát. Mỗi người có khoảng mở cho trải nghiệm riêng.'}</p><a class="quiet-link" href={articlePath(lang, 'seven-layers')}>{en ? 'Understand the framework' : 'Tìm hiểu khung chiêm nghiệm'} <span aria-hidden="true">→</span></a></aside>
      </div>
    </section>

    <section id="path" class="section roadmap" aria-labelledby="path-title">
      <div class="shell"><div class="section-head"><span class="eyebrow">{en ? 'A thoughtful roadmap' : 'Lộ trình có chủ ý'}</span><h2 id="path-title">{t.phasesTitle}</h2></div><div class="pathway">{t.phases.map(([number, title, text], index) => <article class={`phase ${index === 0 ? 'current' : ''}`}><div class="phase-top"><span class="index-number">{number}</span><span class="phase-label">{t.phaseLabels[index]}</span></div><h3>{title}</h3><p>{text}</p></article>)}</div></div>
    </section>

    <section id="connect" class="section contact" aria-labelledby="connect-title">
      <div class="shell contact-grid">
        <div><span class="eyebrow">{t.contactEye}</span><h2 id="connect-title">{t.contactTitle}</h2><p class="lead">{t.contactCopy}</p><a class="button" href="#journal">{en ? 'Begin with a reflection' : 'Bắt đầu từ một tản văn'} <Arrow /></a><p class="small-copy contact-status"><span class="small-dot" aria-hidden="true"></span>{en ? 'Sign-up is not open yet. Updates will be shared here.' : 'Chưa mở đăng ký. Thông tin mới sẽ được cập nhật tại đây.'}</p></div>
        <details class="preview-panel"><summary>{t.previewSummary}<span aria-hidden="true">+</span></summary><div class="contact-card"><h3>{t.previewTitle}</h3><p class="form-note" id="preview-notice">{t.formNotice}</p><form id="interest-form" aria-describedby="preview-notice">
          <fieldset disabled><legend class="sr-only">{t.previewTitle}</legend>
            <label for="name">{t.formName}</label><input id="name" name="name" value={t.previewName} autocomplete="off" maxlength="100" required />
            <label for="email">{t.formEmail}</label><input id="email" name="email" type="email" value="friend@example.com" autocomplete="off" maxlength="254" required />
            <label for="interest">{t.formInterest}</label><select id="interest" name="interest" required>{t.formOptions.map((option, index) => <option value={index === 0 ? '' : String(index)} disabled={index === 0} selected={index === 0}>{option}</option>)}</select>
            <button class="button" type="submit">{t.formButton} <Arrow /></button>
          </fieldset>
          <p class="form-result" id="form-result" role="status" hidden>{t.formSuccess}</p>
          <noscript><p class="form-note">{en ? 'Enable JavaScript to try this local preview. The form remains disabled and will not submit.' : 'Bật JavaScript để thử bản xem trước cục bộ. Biểu mẫu đang được khóa và sẽ không gửi dữ liệu.'}</p></noscript>
        </form></div></details>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
  <script>
    const form = document.querySelector<HTMLFormElement>('#interest-form');
    const result = document.querySelector<HTMLElement>('#form-result');
    if (form && result) {
      form.addEventListener('submit', event => {
        event.preventDefault();
        if (form.reportValidity()) result.hidden = false;
      });
      form.addEventListener('input', () => { result.hidden = true; });
      const fieldset = form.querySelector('fieldset');
      if (fieldset) fieldset.disabled = false;
    }
  </script>
</BaseLayout>
