---
import { contactPath } from "../../data/contact-channels";
import HomePhoto from "../../components/HomePhoto.astro";
import EcosystemOrbit from '../../components/EcosystemOrbit.astro';
import HomeDiscovery from '../../components/HomeDiscovery.astro';
import { homeCopy, beginnerArticles, featuredArticles } from '../../data/home';
import RiceLandscapes from '../../components/RiceLandscapes.astro';
import FounderJourney from '../../components/FounderJourney.astro';
import ContactForm from '../../components/ContactForm.astro';
import BeginHere from '../../components/BeginHere.astro';
import '../../styles/story-home.css';
import Arrow from '../../components/Arrow.astro';
import '../../styles/hybrid-nature.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RootMark from '../../components/RootMark.astro';
import { languages, getCopy, type Language } from '../../data/site';
import { articlePath, journalPath } from '../../data/articles';

export function getStaticPaths() {
  return languages.map(lang => ({ params: { lang } }));
}
const lang = Astro.params.lang as Language;
const en = lang === 'en';
const t = getCopy(lang);
const home = homeCopy[lang];
const alternatePath = `/${en ? 'vi' : 'en'}/`;
const natureImages = ['roots-garden.webp', 'vietnam-rice-fields.jpg', 'farmer-field.jpg'];
---
<BaseLayout lang={lang} title={`${t.title} | Hương Thiền Nature`} description={t.desc} alternatePath={alternatePath}>
  <Header lang={lang} alternatePath={alternatePath} />
  <main id="main-content" class="hybrid-home" tabindex="-1">
    <section class="hero hybrid-hero" aria-labelledby="hero-title">
      <div class="hybrid-scene" aria-hidden="true">
        <img class="hybrid-scene__canopy" src="/media/mountain-forest.jpg" alt={en ? 'Forested mountain slopes beneath clouds. Photo: Andrei Mike, Unsplash.' : 'Sườn núi phủ rừng xanh dưới mây trời. Ảnh: Andrei Mike, Unsplash.'} width="1920" height="1280" fetchpriority="high" decoding="async" />
        <div class="hybrid-scene__veil"></div>
        <div class="hybrid-scene__sun"></div>
        <div class="hybrid-scene__mist hybrid-scene__mist--one"></div>
        <div class="hybrid-scene__mist hybrid-scene__mist--two"></div>
        <div class="hybrid-scene__foliage"></div>
      </div>
      <div class="hybrid-hero__layout">
        <div class="hybrid-hero__copy">
          <span class="hybrid-hero__eyebrow">{t.eyebrow}</span>
          <h1 id="hero-title" set:html={t.hero} />
          <p class="lead">{t.lead}</p>
          <div class="hero-actions">
            <a class="button" href={articlePath(lang, beginnerArticles[0].slug)}>{home.start} <Arrow /></a>
            <a class="quiet-link" href="#story">{t.storyCta} <span aria-hidden="true">→</span></a>
          </div>
          <div class="hero-footnote"><span class="small-dot" aria-hidden="true"></span><p>{t.note}</p></div>
        </div>
      </div>
      <span class="hybrid-hero__index" aria-hidden="true">HƯƠNG THIỀN · NATURE</span>
      <div class="hybrid-hero__bottom"><span>{t.rootsNote}</span><a href="#story">{en ? 'Read on' : 'Đọc tiếp'} <span aria-hidden="true">↓</span></a></div>
    </section>
    <section id="story" class="section roots" aria-labelledby="story-title">
      <div class="shell">
        <div class="intro-grid">
          <div class="intro-side"><span class="eyebrow">{t.introEyebrow}</span><RootMark class="intro-root" /><p class="intro-mark">{t.introMark}</p></div>
          <div class="intro-copy"><h2 id="story-title">{t.introTitle}</h2><p class="lead">{t.introCopy}</p><a class="quiet-link" href="#journey">{en ? "Read my story" : "Đọc câu chuyện của mình"} <Arrow /></a></div>
        </div>
      </div>
    </section>

    <FounderJourney lang={lang} />

    <HomeDiscovery lang={lang} />

    <RiceLandscapes lang={lang} />

    <section id="practice" class="section practice" aria-labelledby="practice-title">
      <div class="shell practice-grid">
        <figure class="practice-image"><HomePhoto photo="seated-in-grass" {lang} /></figure>
        <div><span class="eyebrow">{t.practiceEye}</span><h2 id="practice-title" set:html={t.practiceTitle} /><p class="lead">{t.practiceCopy}</p><ol class="steps">{t.steps.map(([n, title, text]) => <li><span class="step-number" aria-hidden="true">{n}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol><a class="quiet-link" href={articlePath(lang, 'returning-attention')}>{en ? 'Try a one-minute practice' : 'Thử một phút thực tập'} <Arrow /></a></div>
      </div>
      <figure class="shell practice-reminder">
        <HomePhoto photo="quiet-reminder" {lang} />
        <figcaption>{en ? 'A small reminder from a picture on the wall. Give yourself a steady seat while things take their time.' : 'Một lời nhắc trên tường. Có những chuyện cần thời gian để lắng xuống. Trong lúc ấy, mình có thể cho mình một chỗ ngồi vững.'}</figcaption>
      </figure>
    </section>

    <section id="nature" class="section nature" aria-labelledby="nature-title">
      <div class="shell">
        <div class="section-head split-head"><div><span class="eyebrow">{t.natureEye}</span><h2 id="nature-title">{t.natureTitle}</h2></div><p>{t.natureCopy}</p></div>
        <EcosystemOrbit lang={lang} cards={t.natureCards} images={natureImages} />
        <div class="nature-photos">
          <figure><HomePhoto photo="outdoor-kitchen" {lang} /><figcaption>{en ? 'Preparing a meal outdoors' : 'Sửa soạn bữa ăn bên bếp củi'}</figcaption></figure>
          <figure><HomePhoto photo="together-by-sea" {lang} /><figcaption>{en ? 'A moment together by the sea' : 'Một khoảnh khắc bên nhau ngoài biển'}</figcaption></figure>
        </div>
        <div class="nature-bottom"><p class="note">{t.natureNote}</p><a class="quiet-link" href={articlePath(lang, 'listening-to-nature')}>{en ? 'Take a mindful walk' : 'Một cuộc gặp với thiên nhiên'} <Arrow /></a></div>
      </div>
    </section>

    <section id="people" class="section people" aria-labelledby="people-title">
      <div class="shell people-grid">
        <figure class="portrait-wrap"><HomePhoto photo="mountain-lake" {lang} /></figure>
        <div><span class="eyebrow">{t.peopleEye}</span><h2 id="people-title">{t.peopleTitle}</h2><div class="people-copy"><article class="person"><span class="role">{t.founderRole}</span><h3>Hương Thiền</h3><p>{t.founderCopy}</p></article><article class="person"><span class="role">{t.coRole}</span><h3>Kiều Mạnh</h3><p>{t.coCopy}</p></article></div></div>
      </div>
    </section>

    <section id="journal" class="section journal" aria-labelledby="journal-title">
      <div class="shell">
        <div class="section-head split-head"><div><span class="eyebrow">{t.journalEye}</span><h2 id="journal-title">{home.featuredTitle}</h2></div><p>{home.featuredDescription}</p></div>
        <div class="journal-grid">{featuredArticles.map(article => {
          const translation = article.translations[lang];
          return <article class="journal-card"><a class="journal-image" href={articlePath(lang, article.slug)} tabindex="-1" aria-hidden="true"><img src={article.image} alt="" width="720" height="540" loading="lazy" /></a><div class="journal-card-copy"><div class="article-meta"><span>{translation.category}</span><span>{(lang === 'vi' ? article.minutesVi ?? article.minutes : article.minutes)} {t.readTime}</span></div><h3><a href={articlePath(lang, article.slug)}>{translation.title}</a></h3><p>{translation.description}</p><a class="quiet-link" href={articlePath(lang, article.slug)} aria-label={`${t.journalLink}: ${translation.title}`}>{t.journalLink} <Arrow /></a></div></article>;
        })}</div>
        <div class="journal-all"><a class="button" href={journalPath(lang)}>{en ? 'View all articles' : 'Xem tất cả tản văn'} <Arrow /></a></div>
        <aside id="layers" class="reflection-note"><span class="eyebrow">{en ? 'A personal lens' : 'Một góc nhìn cá nhân'}</span><p>{en ? 'The seven-layer framework is a prompt for reflection, not a clinical assessment or a universal scientific map. Each person has room for their own experience.' : 'Bảy tầng là khung chiêm nghiệm cá nhân, không phải công cụ đánh giá lâm sàng hay bản đồ khoa học phổ quát. Mỗi người có khoảng mở cho trải nghiệm riêng.'}</p><a class="quiet-link" href={articlePath(lang, 'seven-layers')}>{en ? 'Understand the framework' : 'Tìm hiểu khung chiêm nghiệm'} <span aria-hidden="true">→</span></a></aside>
      </div>
    </section>

    <section id="path" class="section roadmap" aria-labelledby="path-title">
      <div class="shell"><div class="section-head"><span class="eyebrow">{en ? 'A thoughtful roadmap' : 'Lộ trình dự án'}</span><h2 id="path-title">{t.phasesTitle}</h2></div><div class="pathway">{t.phases.map(([number, title, text], index) => <article class={`phase ${index === 0 ? 'current' : ''}`}><div class="phase-top"><span class="index-number">{number}</span><span class="phase-label">{t.phaseLabels[index]}</span></div><h3>{title}</h3><p>{text}</p></article>)}</div></div>
    </section>

    <BeginHere lang={lang} />

    <section id="connect" class="section contact" aria-labelledby="connect-title">
      <div class="shell contact-grid">
        <div><span class="eyebrow">{t.contactEye}</span><h2 id="connect-title">{t.contactTitle}</h2><p class="lead">{t.contactCopy}</p><a class="quiet-link" href={contactPath(lang)}>{en ? 'Phone, Zalo and email' : 'Điện thoại, Zalo và email'} <Arrow /></a></div>
        <ContactForm lang={lang} />
      </div>
    </section>
  </main>
  <Footer lang={lang} />
  <script>import "../../scripts/hybrid-nature";</script>
</BaseLayout>
