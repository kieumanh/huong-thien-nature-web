---
// Internal Living Zen 2.0 design-system preview. Not in the menu or sitemap; noindex.
// Data comes from brand/ (generated by brand/scripts/build.py) so the page cannot drift from the brand kit.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import palette from '../../../brand/colors/palette.json';
import primitive from '../../../brand/tokens/primitive.json';
import '../../styles/living-zen.css';

const brandIcons = ['thien', 'yoga', 'hoi-tho', 'hoa-sen', 'trai-tim', 'tri-tue', 'hat-giong', 'dat', 'cay', 'nuoc', 'anh-sang', 'mat-trang', 'mat-troi', 'sach', 'nhat-ky', 'an-chay', 'tarot', 'cong-dong', 'phung-su', 'than-tam-tri'];
const functionalIcons = ['home', 'search', 'menu', 'account', 'settings', 'play', 'volume', 'bookmark', 'archive', 'share', 'back', 'bell', 'progress', 'cart', 'calendar', 'help'];
const motifs = ['lotus-layered', 'enso-ink', 'sprout', 'ripple', 'solar-minimal', 'seed-6-no-hoa', 'terraces', 'vesica'];
const concepts = [
  ['a-living-roots', 'A · Living Roots', 'Kế thừa tam giác, hoa sen và đường đất của logo gốc. Ứng viên chính.', '4,35'],
  ['b-zen-essence', 'B · Zen Essence', 'Một bông sen kiêm chiếc lá trên một nét đất; gọn nhất ở cỡ nhỏ.', '3,90'],
  ['c-inner-light', 'C · Inner Light', 'Vòng ensō mở, chấm sáng nhận biết và bông sen; sâu lắng hơn.', '3,20'],
];
const type = [
  ['Display', 'var(--display-face)', 'clamp(2.65rem, 5.5vw, 5rem)', 'Hiểu mình. Thuận tự nhiên. Sống tự chủ. Cùng trưởng thành.'],
  ['Headline 1', 'var(--serif)', 'clamp(1.65rem, 3.3vw, 3rem)', 'Thân – Tâm – Trí'],
  ['Title', 'var(--serif)', '1.35rem', 'Nông nghiệp thuận tự nhiên'],
  ['Body', 'var(--sans)', '1rem', 'Trí tuệ và nhận biết lớn lên từ những điều giản dị: ă â đ ê ô ơ ư, ằ ẳ ẵ ắ ặ, ừ ử ữ ứ ự.'],
  ['Caption', 'var(--sans)', '.85rem', 'Tình yêu thương vô điều kiện · Hương Thiền Nature'],
];
---
<BaseLayout lang="vi" title="Living Zen 2.0 · Hệ thống thiết kế | Hương Thiền Nature" description="Trang nội bộ xem trước hệ thống thiết kế Living Zen 2.0 của Hương Thiền Nature." noindex>
  <Header lang="vi" />
  <main id="main-content" class="shell lzds" tabindex="-1">
    <header class="lzds-head">
      <p class="eyebrow">Trang nội bộ · không có trong menu</p>
      <h1>Living Zen 2.0</h1>
      <p class="lead">Hệ thống thiết kế hữu cơ của Hương Thiền Nature: có gốc rễ trong đất, có khoảng lặng trong tâm, có ánh sáng trong trí. Bộ đầy đủ (logo, họa tiết, mẫu in, brand book) nằm trong thư mục <code>brand/</code> của repository.</p>
      <nav class="lzds-nav" aria-label="Mục lục"><a href="#logo">Logo</a><a href="#color">Màu</a><a href="#type">Chữ</a><a href="#icons">Icon</a><a href="#patterns">Họa tiết</a><a href="#components">Thành phần</a><a href="#motion">Chuyển động</a><a href="#tokens">Token</a></nav>
    </header>

    <section id="logo" aria-labelledby="logo-title">
      <h2 id="logo-title">Logo: ba phương án chờ duyệt</h2>
      <p>Logo trên website vẫn là logo gốc cho đến khi chủ dự án chọn phương án. Điểm theo tiêu chí có trọng số (kế thừa 25%, ghi nhớ 20%, thu nhỏ 20%, khác biệt 15%, đa nền tảng 10%, lâu dài 10%).</p>
      <div class="lzds-grid lzds-grid--3">
        {concepts.map(([key, name, text, score]) => <figure class="zen-card lzds-concept">
          <img src={`/brand/concept-${key}.svg`} alt={`Phương án logo ${name}`} width="200" height="200" loading="lazy" />
          <figcaption><strong>{name}</strong> · {score}/5<br />{text}</figcaption>
        </figure>)}
      </div>
      <h3>Hệ thống của phương án A</h3>
      <div class="lzds-grid lzds-grid--logos">
        <figure class="zen-card"><img src="/brand/htn-primary-forest.svg" alt="Logo chính" width="300" height="231" loading="lazy" /><figcaption>Primary</figcaption></figure>
        <figure class="zen-card"><img src="/brand/htn-horizontal-forest.svg" alt="Logo ngang" width="320" height="100" loading="lazy" /><figcaption>Horizontal</figcaption></figure>
        <figure class="zen-card lzds-dark"><img src="/brand/htn-horizontal-reversed.svg" alt="Logo ngang trên nền xanh rừng" width="320" height="100" loading="lazy" /><figcaption>Reversed</figcaption></figure>
        <figure class="zen-card"><img src="/brand/htn-wordmark-orchid.svg" alt="Wordmark tím lan" width="300" height="100" loading="lazy" /><figcaption>Wordmark · Orchid</figcaption></figure>
        <figure class="zen-card lzds-night"><img src="/brand/htn-mark-golden-on-night.svg" alt="Brand mark vàng trên nền tím đêm" width="120" height="120" loading="lazy" /><figcaption>Golden on Night</figcaption></figure>
        <figure class="zen-card"><img src="/brand/htn-app-icon.svg" alt="App icon" width="120" height="120" loading="lazy" /><figcaption>App icon</figcaption></figure>
      </div>
    </section>

    <section id="color" aria-labelledby="color-title">
      <h2 id="color-title">Màu sắc</h2>
      <h3>Ba màu nhận diện và bốn màu bổ trợ</h3>
      <ul class="lzds-swatches" role="list">
        {[...palette.primary, ...palette.supporting].map(c => <li><span style={`background:${c.hex}`}></span><strong>{c.vi}</strong> · {c.name}<br /><code>{c.hex}</code><small>{c.role}</small></li>)}
      </ul>
      <h3>Tỷ lệ ban ngày (định hướng)</h3>
      <div class="lzds-ratio" role="img" aria-label="Giấy mộc 55%, xanh 25%, tím lan 10%, đất nung 5%, vàng kim 5%"><span style="flex:55;background:#FBF6EA"></span><span style="flex:25;background:#243F32"></span><span style="flex:10;background:#713C63"></span><span style="flex:5;background:#8B523D"></span><span style="flex:5;background:#F4C76B"></span></div>
      <h3>Màu ngữ nghĩa (luôn kèm icon và chữ)</h3>
      <ul class="lzds-semantic" role="list">
        {palette.semantic.map(s => <li style={`background:${s.surface};color:${s.text}`}><strong>{s.id}</strong> {s.rule}</li>)}
      </ul>
    </section>

    <section id="type" aria-labelledby="type-title">
      <h2 id="type-title">Chữ</h2>
      <p>Ba họ chữ: <strong>Dancing Script</strong> cho cảm xúc, <strong>Lora</strong> cho biên tập, <strong>font hệ thống</strong> cho giao diện (tải nhanh, đọc tốt tiếng Việt).</p>
      <dl class="lzds-type">
        {type.map(([name, face, size, sample]) => <div><dt>{name}<small>{size}</small></dt><dd style={`font-family:${face};font-size:${size}`}>{sample}</dd></div>)}
      </dl>
    </section>

    <section id="icons" aria-labelledby="icons-title">
      <h2 id="icons-title">Icon · lưới 24 × 24, nét 1,75</h2>
      <ul class="lzds-icons" role="list">
        {brandIcons.map(name => <li><img src={`/brand/icons/brand-${name}.svg`} alt="" width="32" height="32" loading="lazy" /><span>{name}</span></li>)}
        {functionalIcons.map(name => <li><img src={`/brand/icons/functional-${name}.svg`} alt="" width="32" height="32" loading="lazy" /><span>{name}</span></li>)}
      </ul>
    </section>

    <section id="patterns" aria-labelledby="patterns-title">
      <h2 id="patterns-title">Họa tiết Living Zen</h2>
      <p>46 họa tiết gốc trong tám nhóm (sen, ensō, thực vật, hơi thở, quỹ đạo, hạt giống, tầng đất, hình học ánh sáng), 12 nền lặp, 12 khung, 10 đường chia, 8 nền chất liệu. Dưới đây là một họa tiết mỗi nhóm.</p>
      <ul class="lzds-motifs" role="list">{motifs.map(name => <li><img src={`/brand/motif-${name}.svg`} alt="" width="120" height="120" loading="lazy" /><span>{name}</span></li>)}</ul>
      <div class="lzds-grid lzds-grid--patterns">{['breath-waves', 'leaf-rain', 'terrace-lines', 'enso-dots'].map(name => <img src={`/brand/pattern-${name}.svg`} alt="" width="300" height="200" loading="lazy" />)}</div>
    </section>

    <section id="components" aria-labelledby="components-title">
      <h2 id="components-title">Thành phần giao diện</h2>
      <div class="lzds-grid lzds-grid--2">
        <div class="zen-card lzds-demo">
          <h3>Nút</h3>
          <p class="lzds-row"><a class="button" href="#components">Chính · xanh rừng</a> <a class="button button--tonal" href="#components">Phụ · kem</a> <a class="button button--special" href="#components">Đặc biệt · vàng kim</a> <a class="quiet-link" href="#components">Liên kết</a></p>
          <p class="lzds-row"><button class="button" type="button" disabled>Không khả dụng</button></p>
        </div>
        <div class="zen-card lzds-demo">
          <h3>Biểu mẫu</h3>
          <label class="lzds-field">Tên của bạn<input type="text" placeholder="Hương" /></label>
          <label class="lzds-field lzds-field--error">Email<input type="email" value="huong@" aria-invalid="true" aria-describedby="lzds-error" /><span id="lzds-error">× Email còn thiếu tên miền, ví dụ @gmail.com.</span></label>
        </div>
        <div class="zen-card lzds-demo">
          <h3>Trích dẫn, chip, tiến trình</h3>
          <blockquote class="lzds-quote">Mỗi ngày là một cơ hội để bắt đầu lại.</blockquote>
          <p class="lzds-row"><span class="lzds-chip">Thiền</span><span class="lzds-chip">Chánh niệm</span><span class="lzds-chip">Sống thuận tự nhiên</span></p>
          <div class="lzds-progress" role="progressbar" aria-label="Tiến trình đọc" aria-valuenow="60" aria-valuemin="0" aria-valuemax="100"><span style="width:60%"></span></div>
        </div>
        <div class="zen-card lzds-demo">
          <h3>Trạng thái</h3>
          <p class="lzds-state lzds-state--success">✓ Đã gửi lời nhắn. Tụi mình sẽ trả lời trong vài ngày.</p>
          <p class="lzds-state lzds-state--warning">! Mạng chậm, lời nhắn của bạn vẫn được giữ lại.</p>
          <p class="lzds-state lzds-state--error">× Chưa gửi được. Bạn thử lại sau một phút nhé.</p>
          <p class="lzds-state lzds-state--info">i Chế độ giao diện có thể đổi ở cuối trang.</p>
        </div>
      </div>
    </section>

    <section id="motion" aria-labelledby="motion-title">
      <h2 id="motion-title">Chuyển động</h2>
      <p>Instant 60ms · Fast 150ms · Standard 260ms · Gentle 600ms · Ambient có kiểm soát. Mọi hình động dừng khi bật "giảm chuyển động".</p>
      <ul class="lzds-motifs" role="list">{['breath-circle', 'leaf-sway', 'lotus-bloom', 'orbit'].map(name => <li><img src={`/brand/motion-${name}.svg`} alt="" width="120" height="120" loading="lazy" /><span>{name}</span></li>)}</ul>
    </section>

    <section id="tokens" aria-labelledby="tokens-title">
      <h2 id="tokens-title">Token</h2>
      <p>Ba tầng: primitive → semantic → component, sinh từ <code>brand/scripts/foundation.py</code> vào <code>src/styles/living-zen-tokens.css</code>.</p>
      <dl class="lzds-tokens">
        {Object.entries(primitive.space).map(([k, v]) => <div><dt>space-{k}</dt><dd><span style={`width:${v}`}></span>{v}</dd></div>)}
        {Object.entries(primitive.radius).map(([k, v]) => <div><dt>radius-{k}</dt><dd>{v}</dd></div>)}
        {Object.entries(primitive.duration).map(([k, v]) => <div><dt>duration-{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </section>
  </main>
  <Footer lang="vi" />
</BaseLayout>

<style>
  .lzds { padding-block: var(--space-section); }
  .lzds section { margin-top: var(--lz-space-8); }
  .lzds h3 { margin-top: var(--lz-space-5); font-size: var(--type-card); }
  .lzds-nav { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
  .lzds-nav a { min-height: 44px; display: inline-flex; align-items: center; padding: 0 .9rem; border: 1px solid var(--border); border-radius: 999px; }
  .lzds-grid { display: grid; gap: var(--lz-space-4); margin-top: var(--lz-space-4); }
  .lzds-grid figure { margin: 0; padding: 1rem; text-align: center; }
  .lzds-grid img { margin-inline: auto; max-height: 12rem; width: auto; }
  .lzds-dark { background: #243f32 !important; color: #fbf6ea; }
  .lzds-night { background: #100c24 !important; color: #ffe7a8; }
  .lzds-concept figcaption { text-align: start; }
  .lzds-dark figcaption, .lzds-night figcaption { color: inherit; }
  .lzds-swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); gap: 1rem; padding: 0; list-style: none; }
  .lzds-swatches span { display: block; height: 5rem; margin-bottom: .5rem; border-radius: 14px; border: 1px solid var(--border); }
  .lzds-swatches small { display: block; margin-top: .25rem; color: var(--muted); line-height: 1.45; }
  .lzds-ratio { display: flex; height: 2.5rem; overflow: hidden; border: 1px solid var(--border); border-radius: 12px; }
  .lzds-semantic { display: grid; gap: .5rem; padding: 0; list-style: none; }
  .lzds-semantic li { padding: .6rem .9rem; border-radius: 12px; }
  .lzds-type div { display: grid; gap: .25rem; padding-block: .9rem; border-bottom: 1px solid var(--border); }
  .lzds-type dt small { margin-inline-start: .6rem; color: var(--muted); }
  .lzds-type dd { margin: 0; line-height: 1.3; }
  .lzds-icons, .lzds-motifs { display: grid; grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr)); gap: .75rem; padding: 0; list-style: none; }
  .lzds-icons li, .lzds-motifs li { display: grid; justify-items: center; gap: .35rem; padding: .75rem .25rem; border: 1px solid var(--border); border-radius: 14px; background: #fbf6ea; color: #586557; font-size: .75rem; text-align: center; }
  .lzds-demo { padding: var(--lz-space-5); }
  .lzds-demo h3 { margin-top: 0; }
  .lzds-row { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; margin-top: .75rem; }
  .lzds-field { display: grid; gap: .3rem; margin-top: .8rem; font-size: .9rem; }
  .lzds-field input { min-height: 44px; padding: .5rem .8rem; border: 1px solid var(--border-control); border-radius: var(--radius-input); background: var(--surface-raised); color: var(--foreground); }
  .lzds-field--error input { border-color: var(--error); }
  .lzds-field--error span { color: var(--error); font-size: .85rem; }
  .lzds-quote { margin: .75rem 0 0; padding-inline-start: 1rem; font: italic 1.2rem/1.5 var(--serif); }
  .lzds-chip { padding: .3rem .75rem; border-radius: 999px; background: var(--surface-container); font-size: .85rem; }
  .lzds-progress { height: .5rem; margin-top: 1rem; border-radius: 999px; background: var(--surface-container); overflow: hidden; }
  .lzds-progress span { display: block; height: 100%; background: var(--primary); }
  .lzds-state { margin-top: .6rem; padding: .55rem .8rem; border-radius: 12px; }
  .lzds-state--success { background: var(--success-surface); color: var(--success); }
  .lzds-state--warning { background: var(--warning-surface); color: var(--warning); }
  .lzds-state--error { background: var(--error-surface); color: var(--error); }
  .lzds-state--info { background: var(--info-surface); color: var(--info); }
  .lzds-tokens { display: grid; grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr)); gap: .4rem 1rem; }
  .lzds-tokens div { display: flex; justify-content: space-between; gap: .5rem; padding: .4rem 0; border-bottom: 1px solid var(--border); font-size: .85rem; }
  .lzds-tokens dd { display: flex; align-items: center; gap: .4rem; margin: 0; }
  .lzds-tokens dd span { display: inline-block; height: .5rem; background: var(--forest); border-radius: 2px; }
  @media (min-width: 760px) {
    .lzds-grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .lzds-grid--3, .lzds-grid--logos { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .lzds-grid--patterns { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
