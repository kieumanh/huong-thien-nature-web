  'conscious-economy': '<path d="M7 27C7 35 14 41 24 41C34 41 41 35 41 27"/><path d="M7 27C9 25 11.5 25.2 12.5 27.5M41 27C39 25 36.5 25.2 35.5 27.5"/><g class="ph-ic-accent"><path d="M24 34V19"/><path d="M24 24.5C19.5 24.5 17 22 17 18.5C21 18.5 24 21 24 24.5Z"/><path d="M24 21C24 17 26.5 14.5 31 14.5C31 18.5 28 21 24 21Z"/></g>',
