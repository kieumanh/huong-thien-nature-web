interface Props { name: PhilosophyIconName; class?: string }
const { name, class: extra } = Astro.props as Props;

const petals = [0, 60, 120, 180, 240, 300].map(angle => `<ellipse cx="24" cy="11.5" rx="3.6" ry="6.2" transform="rotate(${angle} 24 24)"/>`).join('');
