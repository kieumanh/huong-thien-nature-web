  'mindful-innovation': '<path d="M24 11C28.5 16 28.5 25 24 31C19.5 25 19.5 16 24 11Z"/><path d="M24 31C15.5 31 9.5 26.5 9 19C16.5 19.5 22 24 24 31Z"/><path d="M24 31C32.5 31 38.5 26.5 39 19C31.5 19.5 26 24 24 31Z"/><g class="ph-ic-accent"><path d="M24 31V40M11 40H37"/><circle cx="11" cy="40" r="1.8"/><circle cx="37" cy="40" r="1.8"/><circle cx="24" cy="40" r="1.8"/></g>',
