---
import Arrow from './Arrow.astro';
import Breadcrumb from './Breadcrumb.astro';
import CourseCompare from './CourseCompare.astro';
import GuidanceSequence from './GuidanceSequence.astro';
import TarotResearch from './TarotResearch.astro';
import { tarotLanding } from '../data/tarot-guidance';
import { tarotCourse, tarotPriceLabel, tarotEnquiryPath } from '../data/courses';
import { feedbackAnchor, feedbackCopy } from '../data/student-feedback';
import { journeyPages, journeyPath } from '../data/journey-pages';
import { zaloUrl } from '../data/contact-channels';
import { meditationFounder } from '../data/people';
import type { Language } from '../data/site';
import '../styles/tarot-guidance.css';

const { lang } = Astro.props as { lang: Language };
const vi = lang === 'vi';
const copy = tarotLanding[lang];
const priceLabel = tarotPriceLabel(lang);
const priced = priceLabel !== tarotPriceLabel(lang, { price: null });
const cardSource = 'https://commons.wikimedia.org/wiki/File:RWS_Tarot_01_Magician.jpg';
---
<main class="shell guidance" id="main-content" tabindex="-1">
  <Breadcrumb {lang} current={tarotCourse[lang].title} parent={{ label: journeyPages.guidance[lang].title, href: journeyPath(lang, 'guidance') }} />

  <header class="guidance-hero">
    <div class="guidance-hero-copy" data-guidance-reveal>
      <p class="eyebrow">{copy.topic}</p>
      <h1 id="guidance-title"><span class="handwritten">{vi ? 'Lắng nghe mình' : 'Listening to yourself'}</span>{' '}{vi ? 'qua tarot' : 'through tarot'}</h1>
      <p class="lead">{copy.lead}</p>
      <div class="guidance-actions">
        <a class="button guidance-button" href={zaloUrl}>{copy.bookingZalo} <Arrow /></a>
        <a class="button button--tonal" href="#session">{copy.outline}</a>
      </div>
      <ul class="guidance-reassure" role="list">
        {copy.reassure.map(item => <li><svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="m4.5 10.5 3.6 3.6 7.4-8" /></svg>{item}</li>)}
      </ul>
      <dl class="guidance-facts">
        {[...copy.facts, [priceLabel, copy.priceLabel]].map(([value, label]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
      </dl>
      {!priced && <p class="guidance-price-note">{copy.priceNote}</p>}
    </div>
    <figure class="guidance-art" data-guidance-reveal>
      <div class="guidance-card-stage">
        <div class="guidance-card-halo" aria-hidden="true"><span>✦</span><span>✧</span></div>
        <img src="/media/guidance/magician.webp" alt={vi ? 'Lá The Magician với một nhân vật đứng trước bàn, tay giơ đũa, xung quanh có hoa đỏ.' : 'The Magician stands at a table, raising a wand among red flowers.'} width="369" height="640" decoding="async" fetchpriority="high" />
      </div>
      <figcaption><a href={cardSource}>{copy.art}</a></figcaption>
    </figure>
  </header>

  <nav class="guidance-jumps" aria-label={copy.navigation} data-guidance-reveal>
    {copy.links.map(([id, label]) => <a href={`#${id}`}>{label} <span aria-hidden="true">↓</span></a>)}
  </nav>

  <section class="guidance-section" id="benefits" aria-labelledby="benefits-title">
    <h2 id="benefits-title" data-guidance-reveal>{copy.benefitsTitle}</h2>
    <ul class="guidance-benefits" role="list">
      {copy.benefits.map(([title, description], index) => <li class="zen-card" data-guidance-reveal>
        <span class="benefit-illustration" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none">
            {index === 0 ? <path d="M24 37S10 29 10 19a7 7 0 0 1 14-1 7 7 0 0 1 14 1c0 10-14 18-14 18Z" /> : index === 1 ? <><circle cx="24" cy="24" r="13" /><path d="M16 25c4-5 12-5 16 0-4 5-12 5-16 0Z" /><circle cx="24" cy="25" r="2" /></> : <><path d="M12 34c3-8 8-11 16-11h7M29 17l6 6-6 6" /><path d="M13 39h6" /></>}
          </svg>
        </span>
        <h3>{title}</h3><p>{description}</p>
      </li>)}
    </ul>
    <div class="guidance-audience" data-guidance-reveal>
      <h3>{copy.audienceTitle}</h3>
      <p>{copy.audience}</p>
    </div>
  </section>

  <section class="guidance-section guidance-session" id="session" aria-labelledby="session-title">
    <div class="guidance-session-intro" data-guidance-reveal>
      <h2 id="session-title">{copy.sessionTitle}</h2>
      <p>{copy.sessionIntro}</p>
      <a class="quiet-link" href="#booking">{copy.booking} <Arrow /></a>
    </div>
    <ol class="progress-line" role="list">
      {copy.steps.map(([minutes, title, detail, id]) => <li {id} data-guidance-reveal>
        <span class="session-duration">{minutes} {vi ? 'phút' : 'min'}</span>
        <div><h3>{title}</h3><p>{detail}</p></div>
      </li>)}
    </ol>
  </section>

  <aside class="guidance-cta-band" aria-labelledby="mid-cta-title" data-guidance-reveal>
    <div>
      <h2 id="mid-cta-title">{copy.midTitle}</h2>
      <p>{copy.midNote}</p>
    </div>
    <a class="button guidance-button" href={zaloUrl}>{copy.bookingZalo} <Arrow /></a>
  </aside>

  <section class="guidance-section guidance-ai" id="human-guidance" aria-labelledby="human-guidance-title">
    <h2 id="human-guidance-title" data-guidance-reveal>{copy.humanGuidance.title}</h2>
    <div class="guidance-ai-options">
      {copy.humanGuidance.options.map(({ title, detail }) => <div class="zen-card guidance-ai-option" data-guidance-reveal>
        <h3>{title}</h3>
        <p>{detail}</p>
      </div>)}
    </div>
    <aside class="guidance-note guidance-note--example" aria-labelledby="human-guidance-example" data-guidance-reveal>
      <div class="guidance-note-heading">
        <span class="guidance-note-mark guidance-note-mark--quote" aria-hidden="true">“</span>
        <h3 id="human-guidance-example">{copy.humanGuidance.exampleTitle}</h3>
      </div>
      <p>{copy.humanGuidance.example}</p>
      <blockquote><p>“{copy.humanGuidance.exampleQuote}”</p></blockquote>
    </aside>
    <div class="guidance-ai-details" data-guidance-reveal>
      {copy.humanGuidance.details.map(([question, answer]) => <details class="guidance-disclosure">
        <summary>{question}</summary>
        <p>{answer}</p>
      </details>)}
    </div>
  </section>

  <section class="guidance-section guidance-host" aria-labelledby="host-title" data-guidance-reveal>
    <img src={meditationFounder.image} alt="" width="810" height="1080" loading="lazy" decoding="async" />
    <div>
      <h2 id="host-title">{copy.hostTitle}</h2>
      <h3>{meditationFounder.name}</h3>
      <p>{copy.hostBio}</p>
      <a class="quiet-link" href={journeyPath(lang, 'story')}>{copy.hostLink} <Arrow /></a>
      <details class="guidance-disclosure guidance-poem">
        <summary id="opening-title">{copy.poemTitle}</summary>
        <blockquote>
          <p>{copy.poem.map((line, index) => <>{line}{index < copy.poem.length - 1 && <br />}</>)}</p>
          <footer>{copy.by}</footer>
        </blockquote>
      </details>
    </div>
  </section>

  <section class="guidance-section" id="reflection" aria-labelledby="connection-title">
    <h2 id="connection-title" data-guidance-reveal>{copy.connectionTitle}</h2>
    <div data-guidance-reveal><GuidanceSequence {lang} /></div>
  </section>

  <TarotResearch {lang} />

  <section class="guidance-section guidance-accordion" id="faq" aria-labelledby="faq-title" data-guidance-reveal>
    <h2 id="faq-title">{copy.faqTitle}</h2>
    {copy.faq.map(([question, answer]) => <details class="guidance-disclosure">
      <summary>{question}</summary><p>{answer}</p>
    </details>)}
    <details class="guidance-disclosure">
      <summary id="scope-title">{copy.noteTitle}</summary>
      <p>{copy.note}</p>
      <ul class="guidance-references">
        <li><a href="https://www.apa.org/practice/guidelines/evidence-based-statement.html">American Psychological Association · Evidence-based practice</a></li>
        <li><a href="https://www.nccih.nih.gov/health/tips/8-things-to-know-about-meditation-and-mindfulness">NCCIH · Meditation and mindfulness</a></li>
      </ul>
    </details>
  </section>

  <p class="guidance-feedback-link"><a class="quiet-link" href={`${journeyPath(lang, 'guidance')}#${feedbackAnchor}`}>{feedbackCopy[lang].link} <Arrow /></a></p>

  <section class="guidance-section" id="compare" aria-labelledby="course-compare-title" data-guidance-reveal>
    <CourseCompare {lang} current="tarot" />
  </section>

  <section class="guidance-section guidance-howto" id="howto" aria-labelledby="howto-title">
    <h2 id="howto-title" data-guidance-reveal>{copy.howtoTitle}</h2>
    <ol class="guidance-howto-steps" role="list">
      {copy.howto.map(([title, detail], index) => <li class="zen-card" data-guidance-reveal>
        <span class="howto-number" aria-hidden="true">{index + 1}</span>
        <h3>{title}</h3><p>{detail}</p>
      </li>)}
    </ol>
  </section>

  <section class="guidance-section guidance-invitation" id="booking" aria-labelledby="invitation-title" data-guidance-reveal>
    <h2 id="invitation-title">{copy.invitation}</h2>
    <p>{copy.invitationNote}</p>
    <p class="guidance-invitation-price"><span>{copy.priceLabel}</span> <strong>{priceLabel}</strong></p>
    <div class="guidance-actions">
      <a class="button guidance-button" href={zaloUrl}>{copy.invitationAction} <Arrow /></a>
      <a class="button button--tonal" href={tarotEnquiryPath(lang)}>{copy.contact}</a>
    </div>
    <p class="guidance-scope">{copy.scope}</p>
  </section>
</main>

<aside class="guidance-sticky" data-guidance-sticky hidden aria-label={copy.stickyLabel}>
  <p><strong>{copy.stickyLabel}</strong><span>{copy.priceLabel}: {priceLabel}</span></p>
  <a class="button guidance-button" href={zaloUrl}>{copy.stickyAction}</a>
</aside>

<script>
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  if ('IntersectionObserver' in window && !motion.matches && !connection?.saveData) {
    const observer = new IntersectionObserver(entries => {
      for (const { isIntersecting, target } of entries) {
        if (!isIntersecting) continue;
        target.classList.add('guidance-revealed');
        observer.unobserve(target);
      }
    });
    document.querySelectorAll('[data-guidance-reveal]').forEach(section => observer.observe(section));
  }

  // Mobile booking bar: appears once the hero has scrolled away and leaves when the booking section arrives.
  const bar = document.querySelector<HTMLElement>('[data-guidance-sticky]');
  const hero = document.querySelector('.guidance-hero');
  const booking = document.querySelector('#booking');
  if (bar && hero && booking && 'IntersectionObserver' in window) {
    let passedHero = false;
    let reachedBooking = false;
    const sync = () => {
      const on = passedHero && !reachedBooking;
      bar.hidden = !on;
      document.body.toggleAttribute('data-sticky-cta', on);
    };
    new IntersectionObserver(([entry]) => { passedHero = !entry.isIntersecting && entry.boundingClientRect.top < 0; sync(); }).observe(hero);
    new IntersectionObserver(([entry]) => { reachedBooking = entry.isIntersecting || entry.boundingClientRect.top < 0; sync(); }).observe(booking);
    // The bar can wrap onto more lines in another language or font; the floating controls follow its real height.
    if ('ResizeObserver' in window) new ResizeObserver(() => {
      const height = Math.ceil(bar.getBoundingClientRect().height);
      if (height > 0) document.body.style.setProperty('--sticky-bar-h', `${height}px`);
    }).observe(bar);
  }
</script>
