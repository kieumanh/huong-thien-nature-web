---
import Arrow from './Arrow.astro';
import Breadcrumb from './Breadcrumb.astro';
import GuidanceSequence from './GuidanceSequence.astro';
import { tarotCopy, tarotLanding, tarotSources } from '../data/tarot-guidance';
import { tarotCourse } from '../data/courses';
import { journeyPages, journeyPath } from '../data/journey-pages';
import { contactPath, zaloUrl } from '../data/contact-channels';
import { meditationFounder } from '../data/people';
import type { Language } from '../data/site';
import '../styles/tarot-guidance.css';

const { lang } = Astro.props as { lang: Language };
const vi = lang === 'vi';
const copy = tarotCopy[lang];
const landing = tarotLanding[lang];
const cardSource = 'https://commons.wikimedia.org/wiki/File:RWS_Tarot_01_Magician.jpg';
const practiceNotes = [
  ['why-tarot', copy.whyTitle, copy.why],
  ['meditation-first', copy.meditationTitle, copy.meditation],
  ['after-the-card', copy.integrationTitle, copy.integration],
] as const;
---
<main class="shell guidance" id="main-content" tabindex="-1">
  <Breadcrumb {lang} current={tarotCourse[lang].title} parent={{ label: journeyPages.guidance[lang].title, href: journeyPath(lang, 'guidance') }} />

  <header class="guidance-hero">
    <div class="guidance-hero-copy" data-guidance-reveal>
      <p class="eyebrow">{landing.topic}</p>
      <h1 id="guidance-title"><span class="handwritten">{vi ? 'Lắng nghe mình' : 'Listening to yourself'}</span>{' '}{vi ? 'qua tarot' : 'through tarot'}</h1>
      <p class="lead">{copy.lead}</p>
      <div class="guidance-actions">
        <a class="button guidance-button" href="#booking">{copy.booking} <Arrow /></a>
        <a class="button button--tonal" href="#session">{copy.outline}</a>
      </div>
      <dl class="guidance-facts">
        {landing.facts.map(([value, label]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
      </dl>
    </div>
    <figure class="guidance-art" data-guidance-reveal>
      <div class="guidance-card-stage">
        <div class="guidance-card-halo" aria-hidden="true"><span>✦</span><span>✧</span></div>
        <img src="/media/guidance/magician.webp" alt={vi ? 'Lá The Magician với một nhân vật đứng trước bàn, tay giơ đũa, xung quanh có hoa đỏ.' : 'The Magician stands at a table, raising a wand among red flowers.'} width="369" height="640" decoding="async" />
      </div>
      <figcaption><a href={cardSource}>{copy.art}</a></figcaption>
    </figure>
  </header>

  <nav class="guidance-jumps" aria-label={landing.navigation} data-guidance-reveal>
    {landing.links.map(([id, label]) => <a href={`#${id}`}>{label} <span aria-hidden="true">↓</span></a>)}
  </nav>

  <section class="guidance-section guidance-intro" aria-labelledby="experience-title" data-guidance-reveal>
    <h2 id="experience-title">{landing.introTitle}</h2>
    <p class="lead">{landing.intro}</p>
  </section>

  <section class="guidance-section" id="benefits" aria-labelledby="benefits-title">
    <h2 id="benefits-title" data-guidance-reveal>{landing.benefitsTitle}</h2>
    <ul class="guidance-benefits" role="list">
      {landing.benefits.map(([title, description], index) => <li class="zen-card" data-guidance-reveal>
        <span class="guidance-benefit-symbol" aria-hidden="true">{['◉', '◈', '✦'][index]}</span>
        <h3>{title}</h3><p>{description}</p>
      </li>)}
    </ul>
    <div class="guidance-audience" data-guidance-reveal>
      <div><h3>{landing.audienceTitle}</h3><p>{landing.preparation}</p></div>
      <ul>{landing.audience.map(item => <li>{item}</li>)}</ul>
    </div>
  </section>

  <section class="guidance-section guidance-session" id="session" aria-labelledby="session-title">
    <div class="guidance-session-intro" data-guidance-reveal>
      <h2 id="session-title">{copy.sessionTitle}</h2>
      <p>{copy.sessionIntro}</p>
      <a class="quiet-link" href="#booking">{copy.booking} <Arrow /></a>
    </div>
    <ol class="progress-line" role="list">
      {copy.steps.map(([minutes, title, detail]) => <li data-guidance-reveal>
        <span class="session-duration">{minutes} {vi ? 'phút' : 'min'}</span>
        <div><h3>{title}</h3><p>{detail}</p></div>
      </li>)}
    </ol>
  </section>

  <section class="guidance-section" id="reflection" aria-labelledby="connection-title">
    <h2 id="connection-title" data-guidance-reveal>{copy.connectionTitle}</h2>
    <div data-guidance-reveal><GuidanceSequence {lang} /></div>
    <div class="guidance-exercise" data-guidance-reveal>
      <img src="/media/guidance/magician.webp" width="369" height="640" alt="" loading="lazy" decoding="async" />
      <div>
        <h3>{copy.exerciseTitle}</h3>
        <details class="guidance-disclosure">
          <summary>{copy.exerciseLabel}</summary>
          <p>{copy.exercise}</p>
        </details>
      </div>
    </div>
  </section>

  <section class="guidance-section guidance-host" aria-labelledby="host-title" data-guidance-reveal>
    <img src={meditationFounder.image} alt="" width="810" height="1080" loading="lazy" decoding="async" />
    <div>
      <h2 id="host-title">{landing.hostTitle}</h2>
      <h3>{meditationFounder.name}</h3>
      <p>{meditationFounder.bio[lang]}</p>
      <a class="quiet-link" href={journeyPath(lang, 'story')}>{landing.hostLink} <Arrow /></a>
    </div>
  </section>

  <section class="guidance-section guidance-opening" aria-labelledby="opening-title" data-guidance-reveal>
    <div>
      <h2 id="opening-title" class="handwritten">{copy.openingTitle}</h2>
      <blockquote>
        <p>{copy.poem.map((line, index) => <>{line}{index < copy.poem.length - 1 && <br />}</>)}</p>
        <footer>{copy.by}</footer>
      </blockquote>
      <p>{copy.opening}</p>
    </div>
    <figure>
      <img src="/media/pixabay-2608830.webp" width="880" height="586" loading="lazy" decoding="async" alt={vi ? 'Nước chảy quanh các tảng đá giữa rừng.' : 'Water flowing around rocks in a forest.'} />
      <figcaption><a href="https://pixabay.com/photos/nature-water-river-stream-rocks-2608830/">Pixabay</a></figcaption>
    </figure>
  </section>

  <section class="guidance-section guidance-accordion" aria-labelledby="more-title" data-guidance-reveal>
    <h2 id="more-title">{landing.moreTitle}</h2>
    {practiceNotes.map(([id, title, paragraphs]) => <details class="guidance-disclosure">
      <summary id={id}>{title}</summary>
      {paragraphs.map(paragraph => <p>{paragraph}</p>)}
    </details>)}
    <details class="guidance-disclosure">
      <summary>{vi ? 'Hiểu thêm về trực giác và biểu tượng' : 'More about intuition and symbolism'}</summary>
      <dl class="guidance-connections">
        {copy.connection.map(([title, description]) => <div><dt>{title}</dt><dd>{description}</dd></div>)}
      </dl>
      <p>{copy.connectionNote}</p>
    </details>
    <details class="guidance-disclosure" id="guidance-sources">
      <summary>{copy.sourcesTitle}</summary>
      <p>{copy.sourcesIntro}</p>
      <div class="guidance-portraits">
        {tarotSources.map(person => <article class="zen-card guidance-person">
          {person.image ? <figure>
            <img src={`/media/guidance/${person.image}.webp`} width="300" height="365" loading="lazy" decoding="async" alt={person.name} />
            <figcaption><a href={person.photo}>{person.credit}<span class="sr-only"> · {copy.picture} {person.name}</span></a></figcaption>
          </figure> : <div class="guidance-work"><cite>{person.work}</cite><small>{person.publication}</small></div>}
          <div>
            <h3>{person.name}</h3>
            <p>{person[lang]}</p>
            <a class="quiet-link" href={person.source}>{copy.original}<span class="sr-only"> · {person.name}</span></a>
            {person.portraitProfile && <div><a class="quiet-link" href={person.portraitProfile}>
              {vi ? 'Xem ảnh trên trang Editorial Kairós' : 'View the photo at Editorial Kairós'}
            </a></div>}
          </div>
        </article>)}
      </div>
      <h3>{copy.booksTitle}</h3>
      {copy.books.map(paragraph => <p>{paragraph}</p>)}
      <ul class="guidance-references">
        <li><a href="https://wellcomecollection.org/works/wkfv6fww">William James · The Varieties of Religious Experience</a></li>
        <li><a href="https://guides.library.unt.edu/tarot/books">University of North Texas Libraries · Tarot Books &amp; Resources</a></li>
        <li><a href="https://redwheelweiser.com/book/tarot-for-your-self-9781578636792/">Mary K. Greer · Tarot for Your Self</a></li>
      </ul>
    </details>
  </section>

  <section class="guidance-section guidance-accordion" id="faq" aria-labelledby="faq-title" data-guidance-reveal>
    <h2 id="faq-title">{landing.faqTitle}</h2>
    {landing.faq.map(([question, answer]) => <details class="guidance-disclosure">
      <summary>{question}</summary><p>{answer}</p>
    </details>)}
    <details class="guidance-disclosure">
      <summary id="scope-title">{copy.noteTitle}</summary>
      {copy.note.map(paragraph => <p>{paragraph}</p>)}
      <ul class="guidance-references">
        <li><a href="https://www.apa.org/practice/guidelines/evidence-based-statement.html">American Psychological Association · Evidence-based practice</a></li>
        <li><a href="https://www.nccih.nih.gov/health/tips/8-things-to-know-about-meditation-and-mindfulness">NCCIH · Meditation and mindfulness</a></li>
      </ul>
    </details>
  </section>

  <section class="guidance-section guidance-invitation" id="booking" aria-labelledby="invitation-title" data-guidance-reveal>
    <h2 id="invitation-title">{copy.invitation}</h2>
    <p>{copy.invitationNote}</p>
    <div class="guidance-actions">
      <a class="button guidance-button" href={zaloUrl}>{copy.invitationAction} <Arrow /></a>
      <a class="quiet-link" href={contactPath(lang)}>{copy.contact}</a>
    </div>
  </section>
</main>

<script>
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  if ('IntersectionObserver' in window && !motion.matches && !connection?.saveData) {
    const observer = new IntersectionObserver(entries => {
      for (const { isIntersecting, target } of entries) {
        if (!isIntersecting) continue;
        target.classList.add('guidance-revealed');
        observer.unobserve(target);
      }
    });
    document.querySelectorAll('[data-guidance-reveal]').forEach(section => observer.observe(section));
  }
</script>
