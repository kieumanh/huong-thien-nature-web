---
import Arrow from './Arrow.astro';
import { tarotResearchCopy, tarotSources } from '../data/tarot-guidance';
import type { Language } from '../data/site';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const copy = tarotResearchCopy[lang];
---
<section class="guidance-section guidance-research" id="research" aria-labelledby="research-title">
  <header data-guidance-reveal>
    <h2 id="research-title">{copy.heading}</h2>
    <p class="lead" id="why-tarot">{copy.intro}</p>
  </header>

  <aside class="guidance-note guidance-note--reflection" aria-labelledby="barnum-title" data-guidance-reveal>
    <div class="guidance-note-heading">
      <span class="guidance-note-mark" aria-hidden="true">✧</span>
      <h3 id="barnum-title">{copy.checkTitle}</h3>
    </div>
    <p>{copy.check}</p>
    <a class="quiet-link" href="https://dictionary.apa.org/barnum-effect">{copy.reference} <Arrow /></a>
  </aside>

  <section class="guidance-primary-sources" id="guidance-sources" aria-labelledby="guidance-sources-title" data-guidance-reveal>
    <h3 id="guidance-sources-title">{copy.sourcesTitle}</h3>
    <p>{copy.sourcesIntro}</p>
    <div class="guidance-portraits">
      {tarotSources.map(person => <article class:list={['zen-card guidance-person', { 'guidance-person--portrait': person.image }]} data-guidance-reveal>
        {person.image && <figure>
          <img src={`/media/guidance/${person.image}.webp`} width="300" height="365" loading="lazy" decoding="async" alt={person.name} />
          <figcaption><a href={person.photo}>{person.credit}<span class="sr-only"> · {copy.picture} {person.name}</span></a></figcaption>
        </figure>}
        <div>
          <h4>{person.name}</h4>
          {person.work && <p class="guidance-work"><cite lang="en">{person.work}</cite> · {person.publication}</p>}
          <p>{person[lang]}</p>
          <a class="quiet-link" href={person.source}>{copy.original}<span class="sr-only"> · {person.name}</span></a>
          {person.portraitProfile && <div><a class="quiet-link" href={person.portraitProfile}>
            {lang === 'vi' ? 'Xem ảnh trên trang Editorial Kairós' : 'View the photo at Editorial Kairós'}
          </a></div>}
        </div>
      </article>)}
    </div>
    <h4>{copy.booksTitle}</h4>
    <ul class="guidance-references">
      <li><a href="https://wellcomecollection.org/works/wkfv6fww">William James · The Varieties of Religious Experience</a></li>
      <li><a href="https://guides.library.unt.edu/tarot/books">University of North Texas Libraries · Tarot Books &amp; Resources</a></li>
      <li><a href="https://redwheelweiser.com/book/tarot-for-your-self-9781578636792/">Mary K. Greer · Tarot for Your Self</a></li>
    </ul>
  </section>
</section>
