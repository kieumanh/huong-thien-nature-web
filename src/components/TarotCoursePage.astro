---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import TarotGuidance from './TarotGuidance.astro';
import { tarotCourse, coursePath } from '../data/courses';
import type { Language } from '../data/site';

const { lang } = Astro.props as { lang: Language };
const { title, description } = tarotCourse[lang];
const alternatePath = coursePath(lang === 'vi' ? 'en' : 'vi');
---
<BaseLayout {lang} title={`${title} | Hương Thiền Nature`} {description} {alternatePath} aboutOrganization>
  <Header {lang} {alternatePath} />
  <TarotGuidance {lang} />
  <Footer {lang} />
</BaseLayout>
