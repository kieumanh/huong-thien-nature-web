---
// Soft animated line icons for the landing style (24 × 24 grid, 1.6 stroke). Decorative only: always aria-hidden.
// Motion is CSS-only (animated-icons.css) and is switched off under prefers-reduced-motion.
import '../styles/animated-icons.css';

export type IconName = 'breath' | 'leaf' | 'sprout' | 'heart' | 'wave' | 'path' | 'compass' | 'lotus' | 'sun' | 'home' | 'book' | 'gem' | 'chat' | 'hands';
interface Props { name: IconName; class?: string }
const { name, class: extra } = Astro.props as Props;
const icons: Record<IconName, string> = {
  breath: '<circle class="ai-ring ai-ring--outer" cx="12" cy="12" r="9"/><circle class="ai-ring ai-ring--mid" cx="12" cy="12" r="5.4"/><circle class="ai-dot" cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"/>',
  leaf: '<g class="ai-sway"><path d="M5 19c0-8 5-13.5 14-14.5 0 9-5 14.5-14 14.5Z"/><path d="M5 19 14 10"/></g>',
  sprout: '<path d="M12 21v-9"/><path class="ai-leaf-l" d="M12 14.5c-4.5 0-7-2.4-7-6.5 4.2 0 7 2.2 7 6.5Z"/><path class="ai-leaf-r" d="M12 11.5c0-4 2.4-6.5 7-6.5 0 4.2-2.4 6.5-7 6.5Z"/><path d="M8 21h8"/>',
  heart: '<path class="ai-pulse" d="M12 20s-7.5-4.4-7.5-10A4.2 4.2 0 0 1 12 7.4 4.2 4.2 0 0 1 19.5 10c0 5.6-7.5 10-7.5 10Z"/>',
  wave: '<path class="ai-wave ai-wave--1" d="M3 8.5c2.2-2 3.8-2 6 0s3.8 2 6 0 3.8-2 6 0"/><path class="ai-wave ai-wave--2" d="M3 13c2.2-2 3.8-2 6 0s3.8 2 6 0 3.8-2 6 0"/><path class="ai-wave ai-wave--3" d="M3 17.5c2.2-2 3.8-2 6 0s3.8 2 6 0 3.8-2 6 0"/>',
  path: '<path class="ai-flow" d="M6 21c5.5 0 9.5-2.2 7-6.2S7 11.6 9.5 5"/><path class="ai-spark" d="M17 3v4M15 5h4"/>',
  compass: '<circle cx="12" cy="12" r="9"/><g class="ai-needle"><path d="m15.6 8.4-2 5.2-5.2 2 2-5.2 5.2-2Z"/></g>',
  lotus: '<path class="ai-petal ai-petal--c" d="M12 4.5c2.6 2.3 3.6 5.4 0 9.5-3.6-4.1-2.6-7.2 0-9.5Z"/><path class="ai-petal ai-petal--l" d="M12 14c-4.6.2-7-2.4-7.5-6 3.3-.2 6 1 7.5 3.4"/><path class="ai-petal ai-petal--r" d="M12 14c4.6.2 7-2.4 7.5-6-3.3-.2-6 1-7.5 3.4"/><path d="M6 19h12"/>',
  sun: '<circle class="ai-core" cx="12" cy="12" r="3.6"/><g class="ai-rays"><path d="M12 3v2.4M12 18.6V21M3 12h2.4M18.6 12H21M5.6 5.6l1.7 1.7M16.7 16.7l1.7 1.7M5.6 18.4l1.7-1.7M16.7 7.3l1.7-1.7"/></g>',
  home: '<path d="M3.5 11.5 12 4.5l8.5 7"/><path d="M6 10.2V20h12v-9.8"/><path d="M10 20v-4.5h4V20"/><circle class="ai-glow" cx="12" cy="12" r="1.3" fill="currentColor" stroke="none"/>',
  book: '<path d="M12 6.5c-2-1.4-4.8-1.8-8-1.4v13c3.2-.4 6-.1 8 1.4 2-1.5 4.8-1.8 8-1.4v-13c-3.2-.4-6 0-8 1.4Z"/><path d="M12 6.5v13"/><path class="ai-spark" d="M19 1.8v3M17.5 3.3h3"/>',
  gem: '<path d="M7 4.5h10l4 4.8-9 10.7L3 9.3l4-4.8Z"/><path d="M3 9.3h18M9.5 4.5 8 9.3l4 10.7 4-10.7-1.5-4.8"/><path class="ai-spark" d="M20 1.5v3M18.5 3h3"/>',
  chat: '<path d="M4 6.5C4 5.1 5.1 4 6.5 4h11C18.9 4 20 5.1 20 6.5v7c0 1.4-1.1 2.5-2.5 2.5H11l-4.5 4V16C5.1 16 4 14.9 4 13.5v-7Z"/><circle class="ai-d ai-d--1" cx="8.6" cy="10" r="1" fill="currentColor" stroke="none"/><circle class="ai-d ai-d--2" cx="12" cy="10" r="1" fill="currentColor" stroke="none"/><circle class="ai-d ai-d--3" cx="15.4" cy="10" r="1" fill="currentColor" stroke="none"/>',
  hands: '<path class="ai-hand ai-hand--l" d="M12 20.5c-2.8-1-5.5-3.6-6.2-7.6-.3-1.7 1.9-2.1 2.8-.7L10 14V6.5c0-1.4 2-1.4 2 0"/><path class="ai-hand ai-hand--r" d="M12 20.5c2.8-1 5.5-3.6 6.2-7.6.3-1.7-1.9-2.1-2.8-.7L14 14V6.5c0-1.4-2-1.4-2 0"/>',
};
---
<svg class:list={['ai', `ai--${name}`, extra]} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[name]} />
