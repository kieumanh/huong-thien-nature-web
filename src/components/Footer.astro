---
import { journeyPath, journeyPages } from '../data/journey-pages';
import { journalPath } from '../data/articles';
import { version } from '../../package.json';
import { getCopy, type Language } from '../data/site';
import { shopPath } from '../data/products';
import { releasesPath, releaseTitle } from '../data/releases';
import { supportFund } from '../data/support-fund';
import { philosophyTagline } from '../data/philosophy';

const { lang } = Astro.props as { lang: Language };
const t = getCopy(lang);
const vi = lang === 'vi';
const home = `/${lang}/`;
const versionPath = releasesPath(lang);
const fund = supportFund[lang];
const fundPath = journeyPath(lang, 'support');
// Câu chủ đạo của website (một nguồn với Living Zen): hai cụm mỗi dòng.
const slogan = philosophyTagline[lang];
const sloganLines = [slogan.slice(0, 2).join(' '), slogan.slice(2).join(' ')];
const notice = vi
  ? 'Nội dung để học và tự thực tập theo sức mình. Việc chăm sóc sức khỏe thể chất và tinh thần cần hướng dẫn chuyên môn.'
  : 'Explore and practise at your own pace. Seek professional guidance for physical and mental health care.';
const groups = [
  {
    title: vi ? 'Hệ sinh thái' : 'Ecosystem',
    links: [
      { label: journeyPages.team[lang].title, url: journeyPath(lang, 'team') },
      { label: vi ? 'Câu chuyện' : 'Our story', url: journeyPath(lang, 'story') },
      { label: journeyPages.philosophy[lang].title, url: journeyPath(lang, 'philosophy') },
      { label: vi ? 'Định hướng' : 'Our direction', url: journeyPath(lang, 'ecosystem') },
      { label: vi ? 'Cửa hàng' : 'Shop', url: shopPath(lang) },
    ],
  },
  {
    title: vi ? 'Khám phá' : 'Explore',
    links: [
      { label: journeyPages.guidance[lang].title, url: journeyPath(lang, 'guidance') },
      { label: t.nav[4], url: journalPath(lang) },
      { label: journeyPages.practice[lang].title, url: journeyPath(lang, 'practice') },
      { label: journeyPages.album[lang].title, url: journeyPath(lang, 'album') },
      { label: releaseTitle[lang], url: versionPath },
    ],
  },
];

---
<footer class="footer">
  <div class="shell">
    <div class="footer-grid">
      <div class="footer-identity">
        <a class="footer-logo" href={home} aria-label={vi ? 'Trang chủ Hương Thiền Nature' : 'Hương Thiền Nature home'}>
          <img src="/media/huong-thien-logo-footer.webp" alt="" width="512" height="512" loading="lazy" decoding="async" />
        </a>
        <div class="footer-slogan">
          <p class="footer-brand">Hương Thiền Nature</p>
          <p class="footer-tagline">{sloganLines.map(line => <span>{line}</span>)}</p>
        </div>
      </div>
      <nav class="footer-navigation" aria-label={vi ? 'Liên kết cuối trang' : 'Footer navigation'}>
        {groups.map(group => (
          <div class="footer-group">
            <h2>{group.title}</h2>
            <ul>
              {group.links.map(link => (
                <li>
                  <a class:list={[{ 'footer-release': link.url === versionPath }]} href={link.url} aria-current={Astro.url.pathname === link.url ? 'page' : undefined}>
                    <span>{link.label}</span>
                    {link.url === versionPath && <span class="footer-version">V{version}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>
    <section class="footer-support" aria-labelledby="footer-support-title">
      <svg class="footer-support__seed" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
        <circle class="fs-ring fs-ring--1" cx="32" cy="50" r="6" />
        <circle class="fs-ring fs-ring--2" cx="32" cy="50" r="6" />
        <path d="M14 52c8-6 28-6 36 0-8 6-28 6-36 0z" fill="#8b6a4a" />
        <path class="fs-stem" d="M32 50c0-9 1-15-1-24" fill="none" stroke="#86b77a" stroke-width="3" stroke-linecap="round" />
        <path class="fs-leaf" d="M31 34c-9-1-14-6-15-13 8 0 14 4 15 13z" fill="#86b77a" />
        <path class="fs-leaf fs-leaf--b" d="M31 28c8-1 13-6 14-13-8 0-13 5-14 13z" fill="#a9d29b" />
        <circle class="fs-bud" cx="31" cy="22" r="3.4" fill="#f0c05a" />
      </svg>
      <div class="footer-support__text">
        <h2 id="footer-support-title">{fund.footerTitle}</h2>
        <p>{fund.footerText}</p>
      </div>
      <a class="footer-support__link" href={fundPath} aria-current={Astro.url.pathname === fundPath ? 'page' : undefined}>{fund.footerAction}<span class="footer-support__arrow" aria-hidden="true">→</span></a>
    </section>
    <p class="footer-notice">{notice}</p>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} Hương Thiền Nature</span>
      <div class="theme-choice js-only">
        <label for="theme-choice">{vi ? 'Giao diện' : 'Appearance'}</label>
        <select id="theme-choice" data-theme-choice>
          <option value="auto">{vi ? 'Theo giờ trong ngày' : 'By time of day'}</option>
          <option value="light">{vi ? 'Luôn sáng' : 'Always light'}</option>
          <option value="dark">{vi ? 'Luôn tối' : 'Always dark'}</option>
          <option value="system">{vi ? 'Theo hệ điều hành' : 'Match my device'}</option>
        </select>
      </div>
      <p class="footer-credit">{vi ? 'Thiết kế và phát triển bởi' : 'Designed and developed by'} <a href="https://zenwork.io.vn/">Zenwork.io.vn</a></p>
    </div>
  </div>
</footer>

<script>
  const select = document.querySelector<HTMLSelectElement>('[data-theme-choice]');
  const theme = (window as unknown as { htnTheme?: { get(): string; set(mode: string): void } }).htnTheme;
  if (select && theme) {
    select.value = theme.get();
    select.addEventListener('change', () => theme.set(select.value));
  }
</script>

<style>
  .footer-grid {
    display: grid;
    gap: clamp(1.4rem, 3vw, 2.5rem);
  }

  /* Logo giữ nguyên tỷ lệ (không cắt tròn) và nằm riêng; tên và câu chủ đạo nằm bên cạnh, không chồng lên logo. */
  .footer-identity { display: flex; align-items: flex-start; gap: 1rem; min-width: 0; }
  .footer-logo { flex: 0 0 4rem; width: 4rem; height: 4rem; overflow: hidden; border-radius: 14px; background: var(--surface); box-shadow: 0 0 0 1px var(--footer-divider); }
  .footer-logo img { width: 100%; height: 100%; object-fit: contain; }
  .footer-slogan { min-width: 0; }
  /* Thứ bậc: tên thương hiệu luôn lớn hơn câu chủ đạo ở cả ba loại thiết bị: điện thoại (dưới 640px), máy tính bảng (640–959px, mặc định), máy tính (từ 960px). */
  .footer-brand { margin: 0; font: 650 1.25rem/1.3 var(--sans); letter-spacing: .12em; text-transform: uppercase; }
  .footer-tagline { margin: .4rem 0 0; font: 1rem/1.45 var(--serif); }
  .footer-tagline span { display: block; text-wrap: balance; }

  .footer-navigation { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem clamp(.75rem, 3vw, 1.75rem); }
  .footer-group h2 { margin: 0 0 .35rem; font: 650 .95rem/1.3 var(--sans); letter-spacing: 0; }
  .footer-group ul { list-style: none; padding: 0; margin: 0; }
  .footer-group a {
    display: inline-flex; flex-wrap: wrap; align-content: center; align-items: center; gap: .15rem .4rem;
    min-height: 44px; padding-block: .3rem; font-size: .875rem; line-height: 1.45; color: var(--footer-link);
  }
  .footer-group a > span:first-child { min-width: 0; overflow-wrap: anywhere; }
  .footer-group a:hover { color: var(--paper); text-decoration: underline; text-underline-offset: .2em; }
  .footer-group a:focus-visible, .footer-logo:focus-visible, .footer-credit a:focus-visible { outline: 2px solid var(--footer-link); outline-offset: 3px; }
  .footer-version {
    display: inline-block; width: max-content; padding: .1rem .42rem;
    border-radius: 999px; background: var(--footer-chip); color: var(--paper); font-size: .72rem; font-weight: 650;
  }

  .footer-support {
    display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .6rem 1rem; align-items: center;
    margin-top: 1.4rem; padding: 1rem clamp(.9rem, 3vw, 1.4rem); border: 1px solid var(--footer-divider); border-radius: 1.1rem;
    background: color-mix(in srgb, var(--footer-chip) 55%, transparent);
  }
  .footer-support__seed { width: 3.6rem; height: 3.6rem; overflow: visible; }
  .footer-support__text h2 { margin: 0; font: 500 1.2rem/1.3 var(--serif); color: var(--paper); }
  .footer-support__text p { margin: .25rem 0 0; max-width: 52ch; font-size: .85rem; line-height: 1.55; color: var(--footer-muted); }
  .footer-support__link {
    grid-column: 1 / -1; justify-self: start; display: inline-flex; align-items: center; min-height: 44px; padding: .4rem 1.1rem;
    border: 1px solid var(--footer-link); border-radius: 999px; color: var(--paper); font-size: .9rem; font-weight: 650;
  }
  .footer-support__arrow { margin-inline-start: .45rem; }
  .footer-support__link:hover { background: var(--footer-chip); text-decoration: underline; text-underline-offset: .2em; }
  .footer-support__link:focus-visible { outline: 2px solid var(--footer-link); outline-offset: 3px; }
  .fs-stem { stroke-dasharray: 30; stroke-dashoffset: 30; animation: fs-grow 3.6s ease-out infinite; }
  .fs-leaf { transform-box: fill-box; transform-origin: 100% 100%; animation: fs-leaf 3.6s ease-out infinite; }
  .fs-leaf--b { transform-origin: 0 100%; animation-delay: .25s; }
  .fs-bud { transform-box: fill-box; transform-origin: center; animation: fs-leaf 3.6s .5s ease-out infinite; }
  .fs-ring { fill: none; stroke: #f0c05a; stroke-width: 1.2; transform-box: fill-box; transform-origin: center; opacity: 0; animation: fs-ripple 3.6s ease-out infinite; }
  .fs-ring--2 { animation-delay: 1.8s; }
  @keyframes fs-grow { 0% { stroke-dashoffset: 30; } 45%, 85% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 0; opacity: .0; } }
  @keyframes fs-leaf { 0%, 25% { opacity: 0; transform: scale(.2); } 55%, 85% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(1); } }
  @keyframes fs-ripple { 0% { opacity: .7; transform: scale(.6); } 100% { opacity: 0; transform: scale(2.6); } }
  @media (prefers-reduced-motion: reduce) {
    .fs-stem { animation: none; stroke-dashoffset: 0; }
    .fs-leaf, .fs-bud { animation: none; opacity: 1; transform: none; }
    .fs-ring { animation: none; }
  }
  @media (min-width: 40rem) {
    .footer-support { grid-template-columns: auto minmax(0, 1fr) auto; }
    .footer-support__link { grid-column: auto; justify-self: end; }
  }
  .footer-notice { margin: 1.25rem 0 .85rem; color: var(--footer-muted); max-width: 68ch; font-size: .8rem; line-height: 1.55; }
  .footer-bottom {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: .1rem 1rem; padding-top: .75rem; border-top: 1px solid var(--footer-divider);
    color: var(--footer-muted); font-size: .8rem; line-height: 1.55;
  }
  .footer-credit a { display: inline-block; padding-block: .4rem; text-decoration: underline; text-underline-offset: .18em; }
  .footer a[aria-current="page"] { text-decoration: underline; text-underline-offset: .2em; }

  @media (max-width: 639px) {
    .footer { text-align: center; }
    .footer-identity { flex-direction: column; align-items: center; gap: .7rem; }
    .footer-logo { flex: none; width: 3.75rem; height: 3.75rem; }
    .footer-brand { font-size: 1.125rem; }
    .footer-tagline { font-size: .9375rem; }
    .footer-navigation {
      padding-block: .85rem;
      border-block: 1px solid var(--footer-divider);
    }
    .footer-group + .footer-group { border-inline-start: 1px solid var(--footer-divider); }
    .footer-group a { display: flex; padding-inline: .35rem; justify-content: center; }
    .footer-group .footer-release { flex-direction: column; gap: .2rem; }
    .footer-bottom { justify-content: center; }
    .footer-support { text-align: center; grid-template-columns: 1fr; justify-items: center; }
    .footer-support__link { justify-self: center; }
    .footer-notice { margin-inline: auto; }
    .footer-bottom { flex-direction: column; }
  }
  @media (min-width: 960px) {
    .footer-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.4fr); }
    /* Máy tính: cột thương hiệu rộng hơn, để mỗi cụm nằm trọn một dòng; tên vẫn lớn hơn câu chủ đạo. */
    .footer-brand { font-size: 1.125rem; }
    .footer-tagline { font-size: .9375rem; }
  }
</style>
