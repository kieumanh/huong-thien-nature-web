---
import { journalPath as journalUrl } from '../data/articles';
import { version } from '../../package.json';
import { getCopy, type Language } from '../data/site';
const { lang } = Astro.props as { lang: Language };
const t = getCopy(lang);
---
<footer class="footer">
  <div class="shell">
    <div class="footer-top">
      <div class="footer-identity"><a class="footer-logo" href={`/${lang}/`} aria-label={lang === 'vi' ? 'Trang chủ Hương Thiền Nature' : 'Hương Thiền Nature home'}><img src="/media/huong-thien-logo-footer.webp" alt="Hương Thiền Nature" width="480" height="480" loading="lazy" /></a><div><div class="footer-brand">Hương Thiền Nature</div><p>{t.footer}</p></div></div>
      <nav class="footer-links" aria-label={lang === 'vi' ? 'Liên kết cuối trang' : 'Footer navigation'}>
        <a href={`/${lang}/#story`}>{t.nav[0]}</a>
        <a href={`/${lang}/#practice`}>{t.nav[1]}</a>
        <a href={journalUrl(lang)}>{t.nav[4]}</a>
        <a href={`/${lang}/#connect`}>{lang === 'vi' ? 'Kết nối' : 'Connect'}</a>
      </nav>
    </div>
    <p class="notice">{t.disclaimer}</p>
    <div class="footer-bottom"><span>© {new Date().getFullYear()} Hương Thiền Nature · V{version}</span><span>{t.rootsNote}</span><a href="#top">{t.top} <span aria-hidden="true">↑</span></a></div>
  </div>
</footer>

<style>
.footer-logo{display:block;flex:0 0 128px;border-radius:20px;overflow:hidden;background:#f7f7ef}
.footer-logo img{display:block;width:128px;height:128px;object-fit:contain}
@media(max-width:767px){.footer-logo{flex-basis:96px;border-radius:16px}.footer-logo img{width:96px;height:96px}}
</style>
