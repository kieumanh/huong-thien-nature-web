---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Breadcrumb from './Breadcrumb.astro';
import ContactForm from './ContactForm.astro';
import AlbumStrip from './AlbumStrip.astro';
import { contactPath, contactEmail, hotline, internationalPhone, supportHotline, supportPhone, supportZaloUrl, zaloUrl } from '../data/contact-channels';
import type { Language } from '../data/site';

interface Props { lang: Language }
const { lang } = Astro.props;
const vi = lang === 'vi';
const title = vi ? 'Liên hệ Hương Thiền Nature' : 'Contact Hương Thiền Nature';
const description = vi
  ? 'Gọi hoặc nhắn Zalo 0868499856, gửi email hoặc để lại lời nhắn cho Hương Thiền Nature qua biểu mẫu.'
  : 'Call Hương Thiền Nature, message us on Zalo, send an email or leave a message using the contact form.';
const phones = [
  { name: 'Hotline / Zalo · Hương Thiền', number: hotline, tel: internationalPhone, zalo: zaloUrl },
  { name: vi ? 'Hotline / Zalo hỗ trợ · Kiều Mạnh' : 'Support hotline / Zalo · Kiều Mạnh', number: supportHotline, tel: supportPhone, zalo: supportZaloUrl },
];
const alternatePath = contactPath(vi ? 'en' : 'vi');
const url = new URL(contactPath(lang), Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  url,
  name: title,
  description,
  inLanguage: lang,
  mainEntity: { '@id': 'https://huongthiennature.com/#organization' },
};
---
<BaseLayout {lang} {title} {description} {alternatePath}>
  <Header {lang} {alternatePath} />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <main id="main-content" class="section contact" tabindex="-1">
    <div class="shell"><Breadcrumb {lang} current={vi ? 'Liên hệ' : 'Contact'} /></div>
    <div class="shell contact-grid">
      <div>
        <h1>{title}</h1>
        <p class="lead">{vi
          ? 'Bạn có thể hỏi về bài tập thiền, sản phẩm trong cửa hàng hoặc gửi góp ý cho nhóm Hương Thiền.'
          : 'Ask us about meditation practices, products in the shop or share your feedback with the Hương Thiền team.'}</p>
        <address class="contact-channels">
          {phones.map((phone) => <div class="zen-card contact-phone">
            <strong>{phone.name}</strong>
            <span class="contact-phone__number">{phone.number}</span>
            <span class="contact-phone__actions"><a class="quiet-link" href={`tel:${phone.tel}`}>{vi ? 'Gọi ngay' : 'Call'}</a><a class="quiet-link" href={phone.zalo}>{vi ? 'Nhắn Zalo' : 'Message on Zalo'}</a></span>
          </div>)}
          <a class="zen-card" href={`mailto:${contactEmail}`}><strong>Email</strong><span>{contactEmail}</span></a>
        </address>
      </div>
      <div id="connect"><ContactForm {lang} standalone /></div>
    </div>
    <div class="shell">
      <AlbumStrip {lang} id="contact-moments" balanced photos={['selfie-toddler-laugh', 'park-peace-sign-baby', 'elder-and-baby-carrier', 'baby-conical-hat-look-up']}
        title={vi ? 'Một mái nhà để ghé' : 'A home to drop by'}
        intro={vi ? 'Vài khoảnh khắc đời thường của tụi mình. Bạn cứ nhắn, tụi mình luôn vui lòng trả lời.' : 'A few everyday moments of ours. Just write; we are always glad to reply.'} />
    </div>
  </main>
  <Footer {lang} />
</BaseLayout>
