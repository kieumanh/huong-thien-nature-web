---
import { contactPath } from '../data/contact-channels';
import EcosystemOverview from './EcosystemOverview.astro';
import HomeCourses from './HomeCourses.astro';
import '../styles/story-home.css';
import '../styles/hybrid-nature.css';
import HomePhoto from './HomePhoto.astro';
import HomeShop from './HomeShop.astro';
import AlbumStrip from './AlbumStrip.astro';
import AlbumImage from './AlbumImage.astro';
import AnimatedIcon from './AnimatedIcon.astro';
import BreathRing from './BreathRing.astro';
import LandingFeelings from './LandingFeelings.astro';
import LandingMotion from './LandingMotion.astro';
import { homeEmpathy } from '../data/empathy';
import { coursePath, frequencyCourse } from '../data/courses';
import ArticleCard from './ArticleCard.astro';
import Arrow from './Arrow.astro';
import ContemplativeScene from './ContemplativeScene.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import LivingZenValues from './LivingZenValues.astro';
import PhilosophyPointer from './PhilosophyPointer.astro';
import { getCopy, type Language } from '../data/site';
import { articlePath, journalPath } from '../data/articles';
import { homeCopy, featuredArticles } from '../data/home';
import { journeyPath } from '../data/journey-pages';
import '../styles/material-home.css';
import '../styles/editorial.css';
import '../styles/journey-pages.css';
import '../styles/landing.css';

const { lang } = Astro.props as { lang: Language };
const vi = lang === 'vi';
const t = getCopy(lang);
const alternatePath = `/${vi ? 'en' : 'vi'}/`;
const description = vi
  ? 'Hương Thiền Nature là dự án về thiền định, chánh niệm và sống thuận tự nhiên do Đỗ Thị Kim Hương sáng lập. Bắt đầu bằng một phút thực hành hoặc tìm hiểu ba trọng tâm của hệ sinh thái.'
  : 'Hương Thiền Nature is a project for meditation, mindfulness and living closer to nature, founded by Đỗ Thị Kim Hương. Begin with a minute of practice or explore the three focal points of its ecosystem.';
const practicePath = journeyPath(lang, 'practice');
const storyPath = journeyPath(lang, 'story');
const teamPath = journeyPath(lang, 'team');
const welcome = homeEmpathy(lang, {
  practice: practicePath, contact: contactPath(lang), frequency: coursePath(lang, frequencyCourse), tarot: coursePath(lang),
  ecosystem: journeyPath(lang, 'ecosystem'), article: slug => articlePath(lang, slug),
});
---
<BaseLayout {lang} title={`Hương Thiền Nature | ${vi ? 'Thiền định, chánh niệm và sống thuận tự nhiên' : 'Meditation, mindfulness and living close to nature'}`} {description} {alternatePath} canonicalPath={`/${lang}/`} aboutOrganization>
  <Header {lang} {alternatePath} />
  <main id="main-content" class="material-home landing-home" tabindex="-1">
    <section class="shell landing-hero material-hero" aria-labelledby="hero-title">
      <div class="landing-hero__copy">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1 id="hero-title">{vi ? 'Có mặt trong' : 'Be present for'}<br /><span class="handwritten">{vi ? 'đời mình.' : 'your own life.'}</span></h1>
        <p class="lead">{vi ? 'Không cần phải ổn, không cần biết thiền. Ở đây có chỗ để bạn ngồi xuống và thở chậm lại.' : 'You don’t need to be okay or know how to meditate. There is a place here to sit down and breathe more slowly.'}</p>
        <div class="material-actions">
          <a class="button" href={practicePath}>{vi ? 'Thực tập một phút' : 'Practise for one minute'} <Arrow /></a>
          <a class="quiet-link" href={storyPath}>{vi ? 'Đọc câu chuyện' : 'Read our story'}</a>
        </div>
      </div>
      <div class="landing-hero__art">
        <AlbumImage id="sunset-lake-path" {lang} eager sizes="(min-width: 860px) 28vw, 88vw" />
      </div>
    </section>

    <LandingFeelings block={welcome} id="welcome" {lang} />

    <section class="shell home-story landing-story" id="story" aria-labelledby="story-title">
      <div class="home-story__photo" data-reveal="fade"><HomePhoto photo="barefoot-by-sea" {lang} /></div>
      <div class="home-story__copy" data-reveal="up">
        <ContemplativeScene motif="mandala" />
        <p class="eyebrow">Hương Thiền</p>
        <h2 id="story-title">{vi ? 'Học cách ở lại với mình' : 'Learning to stay with myself'}</h2>
        <p>{vi ? 'Mình là Hương Thiền (Đỗ Thị Kim Hương). Lớn lên ở Quảng Nam, mình quen tự lo từ sớm, và mãi sau mới nhận ra có những ngày điều tử tế nhất là thừa nhận mình đã mỏi và cho phép mình nghỉ một lát.' : 'I’m Hương Thiền (Đỗ Thị Kim Hương). Growing up in Quảng Nam, I learned to look after myself early, and only years later saw that some days the kindest thing was to admit I was tired and rest a while.'}</p>
        <p>{vi ? 'Từ chỗ ngồi yên ấy, sự chú tâm theo mình ra bữa cơm, ra vườn, ra cách mình lắng nghe một người.' : 'From that quiet seat, attention followed me to the table, into the garden, and into the way I listen to another person.'}</p>
        <div id="journey" class="home-story__links">
          <a class="quiet-link" href={`${storyPath}#journey`}>{vi ? 'Đọc hành trình đầy đủ' : 'Read the full journey'} <Arrow /></a>
        </div>
        <span id="journey-early"></span><span id="journey-learning"></span><span id="journey-today"></span>
      </div>
    </section>

    <LivingZenValues {lang} />

    <PhilosophyPointer {lang} />

    <EcosystemOverview {lang} />

    <HomeCourses {lang} />

    <section class="shell landing-practice" id="practice" aria-labelledby="practice-title">
      <div class="landing-practice__photo" data-reveal="fade">
        <AlbumImage id="prayer-hands-seashore" {lang} sizes="(min-width: 860px) 56vw, 92vw" />
        <BreathRing {lang} />
      </div>
      <div class="landing-practice__copy" data-reveal="up">
        <p class="eyebrow">{vi ? 'Chỉ một phút' : 'Just one minute'}</p>
        <h2 id="practice-title">{vi ? 'Bắt đầu ở chỗ bạn đang ngồi' : 'Start where you are sitting'}</h2>
        <p>{vi ? 'Đặt hai bàn chân xuống sàn. Để ý một hơi thở đang đến, đang đi.' : 'Set both feet on the floor. Notice one breath as it comes and goes.'}</p>
        <a class="button" href={practicePath}>{vi ? 'Mở hướng dẫn thực hành' : 'Open the practice guide'} <Arrow /></a>
      </div>
    </section>

    <section id="journal" class="shell landing-journal" aria-labelledby="journal-title">
      <div class="landing-head" data-reveal="up">
        <p class="eyebrow">{vi ? 'Đọc và học' : 'Read and learn'}</p>
        <h2 id="journal-title">{homeCopy[lang].featuredTitle}</h2>
      </div>
      <div class="journal-grid home-journal-grid">{featuredArticles.map(article => <ArticleCard {article} {lang} />)}</div>
      <p id="layers" class="landing-journal__more">
        <a class="quiet-link" href={journalPath(lang)}>{vi ? 'Tất cả bài viết' : 'All articles'} <Arrow /></a>
        <a class="quiet-link" href={articlePath(lang, 'seven-layers')}>{vi ? 'Khung chiêm nghiệm bảy tầng' : 'The seven-layer framework'} <Arrow /></a>
      </p>
    </section>

    <HomeShop {lang} />

    <div class="shell landing-moments">
      <AlbumStrip {lang} id="journey-photos" balanced photos={['studio-hug-six', 'veggie-sunset', 'park-arms-open', 'baby-conical-hat-smile']}
        title={vi ? 'Khoảnh khắc trên hành trình' : 'Moments along the way'}
        intro={vi ? 'Hình thật từ các buổi chia sẻ, khu vườn và những góc nhỏ trên đường.' : 'Real photographs from sharing sessions, the garden and small corners along the way.'} />
    </div>

    <section class="shell landing-close" id="people" aria-labelledby="close-title">
      <div class="landing-close__photo" data-reveal="fade"><AlbumImage id="stepping-stones-lawn" {lang} sizes="(min-width: 860px) 45vw, 92vw" /></div>
      <div class="landing-close__card" data-reveal="up">
        <span class="landing-icon landing-icon--gold landing-icon--large"><AnimatedIcon name="home" /></span>
        <h2 id="close-title">{vi ? 'Khi bạn sẵn sàng, tụi mình ở đây' : 'When you are ready, we are here'}</h2>
        <p>{vi ? 'Một câu hỏi, một lời chia sẻ hay chỉ một lời chào đều được. Nhóm Hương Thiền sẽ hồi âm khi có thể.' : 'A question, something you wish to share, or simply a hello. The Hương Thiền team will reply when we can.'}</p>
        <div id="connect" class="landing-close__actions">
          <a class="button" href={contactPath(lang)}>{vi ? 'Liên hệ' : 'Contact us'}</a>
          <a class="quiet-link" href={teamPath}>{vi ? 'Gặp đội ngũ và đối tác' : 'Meet the team and our partners'} <Arrow /></a>
        </div>
      </div>
    </section>
  </main>
  <Footer {lang} />
  <LandingMotion />
</BaseLayout>
