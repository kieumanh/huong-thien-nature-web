---
import type { Language } from '../data/site';

const { lang } = Astro.props as { lang: Language };
const vi = lang === 'vi';
const stages = vi ? [
  ['Thiền định', 'Lắng lại', 'Cảm nhận hơi thở hoặc điểm tựa của cơ thể.'],
  ['Tarot', 'Nhìn một hình ảnh', 'Để ý chi tiết mình chú ý đầu tiên và điều nó gợi ra.'],
  ['Tâm lý học', 'Đặt câu hỏi', 'Đối chiếu điều hình ảnh gợi ra với những gì mình biết, rồi chọn một bước nhỏ.'],
] : [
  ['Meditation', 'Settle', 'Notice a breath or where your body is supported.'],
  ['Tarot', 'Look at an image', 'Notice the first detail that draws you in and what it brings to mind.'],
  ['Psychology', 'Ask a question', 'Check the association against what you know and choose a small step.'],
];
---
<div class="guidance-sequence" data-guidance-sequence>
  <ol role="list">
    {stages.map(([method, title, detail], index) => <li data-sequence-step>
      <div class:list={['sequence-glyph', `sequence-glyph--${index + 1}`]} aria-hidden="true">
        {index === 0 ? (
          <svg viewBox="0 0 120 96" fill="none" focusable="false">
            <circle cx="60" cy="45" r="34" fill="currentColor" opacity=".08" />
            <circle class="sequence-breath" data-sequence-motion cx="60" cy="44" r="26" stroke="currentColor" opacity=".32" />
            <path d="M60 60c-13-8-15-19 0-30 15 11 13 22 0 30Z" fill="currentColor" fill-opacity=".19" stroke="currentColor" />
            <path d="M60 60c-13 0-23-5-25-17 12-1 21 5 25 17Zm0 0c13 0 23-5 25-17-12-1-21 5-25 17Z" fill="currentColor" fill-opacity=".1" stroke="currentColor" />
            <path class="sequence-water" d="M43 68c9 4 25 4 34 0M50 75c6 2 14 2 20 0" stroke="currentColor" opacity=".72" />
          </svg>
        ) : index === 1 ? (
          <svg viewBox="0 0 120 96" fill="none" focusable="false">
            <circle cx="60" cy="48" r="34" fill="currentColor" opacity=".08" />
            <g class="sequence-card-back" data-sequence-motion>
              <rect x="39" y="24" width="42" height="56" rx="7" fill="var(--sequence-paper)" stroke="currentColor" opacity=".75" />
            </g>
            <g class="sequence-card-front">
              <rect x="39" y="20" width="42" height="56" rx="7" fill="var(--sequence-paper)" stroke="currentColor" />
              <path d="M60 33c1 7 3 11 10 14-7 3-9 7-10 14-1-7-3-11-10-14 7-3 9-7 10-14Z" fill="currentColor" fill-opacity=".22" stroke="currentColor" />
              <circle cx="70" cy="32" r="1.5" fill="currentColor" />
            </g>
            <path d="M89 26h8m-4-4v8M26 64h8m-4-4v8" stroke="currentColor" opacity=".58" />
          </svg>
        ) : (
          <svg viewBox="0 0 120 96" fill="none" focusable="false">
            <circle cx="60" cy="47" r="34" fill="currentColor" opacity=".08" />
            <path d="M59 44h19a13 13 0 0 1 13 13v14l-9-5H61a11 11 0 0 1-11-11v-2a9 9 0 0 1 9-9Z" fill="currentColor" fill-opacity=".13" stroke="currentColor" opacity=".7" />
            <path d="M44 28h20a13 13 0 0 1 13 13v3a13 13 0 0 1-13 13H43l-10 6V40a11 11 0 0 1 11-12Z" fill="var(--sequence-paper)" stroke="currentColor" />
            <g class="sequence-dialogue" data-sequence-motion fill="currentColor">
              <circle cx="47" cy="42" r="2" /><circle cx="55" cy="42" r="2" /><circle cx="63" cy="42" r="2" />
            </g>
            <path d="M87 25v9m-4.5-4.5h9" stroke="currentColor" opacity=".64" />
          </svg>
        )}
      </div>
      <p class="eyebrow">{method}</p>
      <h3>{title}</h3>
      <p>{detail}</p>
    </li>)}
  </ol>
</div>

<script>
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  if ('IntersectionObserver' in window && !motion.matches && !connection?.saveData) {
    const observer = new IntersectionObserver(entries => {
      for (const { isIntersecting, target } of entries) {
        if (!isIntersecting) continue;
        target.classList.add('sequence-started');
        observer.unobserve(target);
      }
    }, { threshold: .32 });
    document.querySelectorAll('[data-sequence-step]').forEach(step => observer.observe(step));
  }
</script>

<style>
  .guidance-sequence ol { display: grid; gap: .85rem; margin: 0; padding: 0; list-style: none; }
  .guidance-sequence li {
    min-width: 0;
    padding: clamp(.95rem, 2.8vw, 1.45rem);
    background: var(--surface-raised);
    border: 1px solid var(--orchid-line);
    border-radius: var(--radius-card);
  }
  .guidance-sequence .eyebrow { color: var(--orchid); margin-bottom: .3rem; }
  .guidance-sequence h3 + p { margin-top: .35rem; color: var(--muted); }
  .sequence-glyph {
    --sequence-tint: var(--orchid-mist);
    --sequence-paper: var(--surface-raised);
    display: grid;
    place-items: center;
    min-height: 6rem;
    margin-bottom: .8rem;
    border-radius: var(--radius-input);
    color: var(--orchid-deep);
    background: radial-gradient(ellipse at center, var(--sequence-tint), var(--surface-raised) 105%);
  }
  .sequence-glyph--1 { --sequence-tint: var(--success-surface); color: var(--success); }
  .sequence-glyph--3 { --sequence-tint: var(--warning-surface); color: var(--warning); }
  .sequence-glyph svg { width: clamp(6rem, 13vw, 8.5rem); height: auto; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .sequence-card-back, .sequence-card-front { transform-box: fill-box; transform-origin: center; }
  .sequence-card-back { transform: translate(-7px, -1px) rotate(-16deg); }
  .sequence-card-front { transform: translate(6px, 1px) rotate(10deg); }

  @media (max-width: 699px) {
    .guidance-sequence { text-align: center; }
    .guidance-sequence li > p { max-width: 37ch; margin-inline: auto; }
    .sequence-glyph { min-height: 5rem; margin-bottom: .65rem; }
  }
  @media (min-width: 700px) { .guidance-sequence ol { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  @media (prefers-reduced-motion: no-preference) {
    .sequence-started .sequence-breath { transform-origin: 60px 44px; animation: sequence-breathe 2.5s ease-in-out; }
    .sequence-started .sequence-water { transform-origin: 60px 68px; animation: sequence-water 2.5s ease-in-out; }
    .sequence-started .sequence-card-back { animation: sequence-fan-back 1.25s .12s var(--motion-ease) backwards; }
    .sequence-started .sequence-card-front { animation: sequence-fan-front 1.25s .12s var(--motion-ease) backwards; }
    .sequence-started .sequence-dialogue circle { animation: sequence-answer 1.25s ease-in-out; }
    .sequence-started .sequence-dialogue circle:nth-child(2) { animation-delay: .16s; }
    .sequence-started .sequence-dialogue circle:nth-child(3) { animation-delay: .32s; }
    @keyframes sequence-breathe { 50% { transform: scale(1.16); opacity: .65; } }
    @keyframes sequence-water { 50% { transform: translateY(3px) scaleX(1.13); opacity: .43; } }
    @keyframes sequence-fan-back { from { transform: translate(-1px, 2px) rotate(-3deg); } }
    @keyframes sequence-fan-front { from { transform: translate(1px, 2px) rotate(2deg); } }
    @keyframes sequence-answer { 50% { opacity: .45; transform: translateY(-2px); } }
  }
</style>
