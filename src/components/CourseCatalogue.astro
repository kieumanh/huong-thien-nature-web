---
import { courses, coursePath, courseImage } from '../data/courses';
import type { Language } from '../data/site';
const { lang } = Astro.props as { lang: Language };
const vi = lang === 'vi';
---
<section class="journey-section" aria-labelledby="course-list-title">
  <h2 id="course-list-title">{vi ? 'Khóa thực hành đang nhận đăng ký' : 'Available practice courses'}</h2>
  {courses.map(course => <div class="course-card zen-card" data-course={course.id}>
    <div class="course-preview">
      <img src={courseImage(course, lang)} alt={course.thumbnail.alt[lang]} width={course.thumbnail.width} height={course.thumbnail.height} loading="lazy" decoding="async" />
    </div>
    <div class="course-card-copy">
      <p class="eyebrow">{course[lang].eyebrow}</p>
      <h3>{course[lang].title}</h3>
      <p>{course[lang].description}</p>
      {course.thumbnail.source && <p class="course-credit"><a href={course.thumbnail.source}>{course.thumbnail.credit}</a></p>}
      <a class="button" href={coursePath(lang, course)}>{course[lang].action}</a>
    </div>
  </div>)}
</section>
<style>
  .course-card { display: grid; max-width: 53rem; overflow: hidden; margin-top: 1rem; }
  .course-preview { position: relative; min-height: 0; aspect-ratio: 1200 / 630; background: var(--orchid-mist); }
  .course-preview img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .course-card[data-course="golden-frequency"] .course-preview { background: #171236; }
  .course-card[data-course="golden-frequency"] .course-preview img { object-position: 30% 50%; }
  .course-credit { font-size: .8rem; }
  .course-credit a { text-decoration: underline; text-underline-offset: .18em; }
  .course-card-copy { padding: clamp(1rem, 3.5vw, 2rem); }
  .course-card-copy :is(h3, p, a) { margin-top: .55rem; }
  .course-card-copy .eyebrow { margin-top: 0; color: var(--orchid); }
  @media (min-width: 580px) {
    .course-card { grid-template-columns: minmax(8rem, 1.15fr) minmax(0, 2fr); }
    .course-preview { aspect-ratio: auto; }
    /* The Golden Frequency cover carries its title in the picture, so it is shown whole as a featured card. */
    .course-card[data-course="golden-frequency"] { grid-template-columns: minmax(0, 1fr); }
    .course-card[data-course="golden-frequency"] .course-preview { aspect-ratio: 1200 / 630; }
  }
</style>
