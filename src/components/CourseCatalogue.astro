---
import CourseCompare from './CourseCompare.astro';
import StudentFeedback from './StudentFeedback.astro';
import AlbumStrip from './AlbumStrip.astro';
import Arrow from './Arrow.astro';
import { courseCompare, type CourseKey } from '../data/course-compare';
import { courses, coursePath, courseImage } from '../data/courses';
import type { Language } from '../data/site';
const { lang } = Astro.props as { lang: Language };
const vi = lang === 'vi';
---
<section class="journey-section" aria-labelledby="course-list-title">
  <h2 id="course-list-title">{vi ? 'Khóa thực hành đang nhận đăng ký' : 'Available practice courses'}</h2>
  <div class="course-grid">
    {courses.map(course => <article class="course-card" data-course={course.id}>
      <div class="course-preview">
        <img src={courseImage(course, lang)} alt={course.thumbnail.alt[lang]} width={course.thumbnail.width} height={course.thumbnail.height} loading="lazy" decoding="async" />
      </div>
      <div class="course-card-copy">
        <p class="eyebrow">{course[lang].eyebrow}</p>
        <h3>{course[lang].title}</h3>
        <p>{course[lang].description}</p>
        <ul class="course-chips" role="list">{courseCompare[lang].courses[course.id as CourseKey].chips.map(chip => <li>{chip}</li>)}</ul>
        {course.thumbnail.source && <p class="course-credit"><a href={course.thumbnail.source}>{course.thumbnail.credit}</a></p>}
        <a class="button" href={coursePath(lang, course)}>{course[lang].action} <Arrow /></a>
      </div>
    </article>)}
  </div>
</section>
<section class="journey-section" aria-labelledby="course-compare-title">
  <CourseCompare {lang} />
</section>
<section class="journey-section">
  <StudentFeedback {lang} compact />
</section>
<AlbumStrip {lang} id="course-moments" photos={['studio-group', 'lobby-group', 'three-greeting']}
  title={vi ? 'Từ những buổi chia sẻ và gặp gỡ' : 'From our sharing sessions and meetings'}
  intro={vi ? 'Hình ảnh thật từ một chuyến chia sẻ ở Nha Trang, để bạn hình dung không khí của những buổi gặp.' : 'Real photographs from a sharing trip in Nha Trang, so you can picture the atmosphere of our meetings.'} />
<style>
  .course-grid { display: grid; gap: clamp(1rem, 3vw, 1.6rem); margin-top: 1.1rem; }
  .course-card {
    display: flex; flex-direction: column; overflow: hidden; min-width: 0;
    border: 1px solid var(--gold-line); border-radius: var(--radius-feature);
    background: linear-gradient(160deg, var(--gold-wash), var(--surface-raised) 62%); box-shadow: 0 10px 30px #3b2a0b12;
  }
  .course-preview { position: relative; aspect-ratio: 1200 / 630; overflow: hidden; background: var(--plum-deep); }
  .course-preview img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .course-card[data-course="golden-frequency"] .course-preview img { object-position: 30% 50%; }
  .course-card-copy { display: flex; flex: 1; flex-direction: column; align-items: flex-start; gap: .55rem; padding: clamp(1rem, 3.5vw, 1.7rem); }
  .course-card-copy h3 { margin: 0; }
  .course-card-copy p { margin: 0; }
  .course-chips { display: flex; flex-wrap: wrap; gap: .4rem; margin: .2rem 0 0; padding: 0; list-style: none; }
  .course-chips li { padding: .2rem .7rem; border: 1px solid var(--gold-line); border-radius: var(--radius-pill); background: var(--surface-raised); color: var(--foreground); font-size: .8rem; font-weight: 600; }
  .course-credit { font-size: .8rem; }
  .course-credit a { text-decoration: underline; text-underline-offset: .18em; }
  .course-card-copy .button { margin-top: auto; align-self: flex-start; }
  .course-card-copy .eyebrow + h3 { margin-top: .1rem; }
  @media (min-width: 860px) {
    .course-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .course-card-copy .button { margin-top: 1rem; }
  }
</style>
