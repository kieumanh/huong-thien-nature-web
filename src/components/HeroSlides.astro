---
// Home hero slideshow. The slides are the album photos marked `hero: true` in src/data/album.ts, so adding a photo there adds a slide.
// Only the first photo loads at once; the others get their address just before they appear (src/scripts/hero-slides.ts).
// Without JavaScript the first photo simply stays. The slideshow starts by itself every 6 seconds (not under reduced motion or data saver), can be paused, and each dot opens a slide.
import { heroPhotos, albumPhotoSrc, albumThumbSrc } from '../data/album';
import type { Language } from '../data/site';
interface Props { lang: Language }
const { lang } = Astro.props as Props;
const vi = lang === 'vi';
// The first slide is the sunset path, which has always opened the page.
const slides = [...heroPhotos].sort((a, b) => Number(b.id === 'sunset-lake-path') - Number(a.id === 'sunset-lake-path'));
const sizes = '(min-width: 860px) 28vw, 80vw';
---
<div class="hero-slides" data-hero-slides data-interval="6000" role="group" aria-roledescription={vi ? 'trình chiếu ảnh' : 'slideshow'} aria-label={vi ? 'Ảnh từ album Hương Thiền' : 'Photos from the Hương Thiền album'}>
  <div class="hero-slides__stage">
    {slides.map((photo, index) => {
      const full = albumPhotoSrc(photo), thumb = albumThumbSrc(photo);
      return <figure class:list={['hero-slide', { 'is-active': index === 0 }]} data-hero-slide aria-hidden={index === 0 ? undefined : 'true'}>
        {index === 0
          ? <img src={full} srcset={`${thumb} ${photo.thumbWidth}w, ${full} ${photo.width}w`} {sizes} width={photo.width} height={photo.height} alt={photo.alt[lang]} loading="eager" fetchpriority="high" decoding="async" />
          : <img data-src={thumb} data-srcset={`${thumb} ${photo.thumbWidth}w, ${full} ${photo.width}w`} {sizes} width={photo.width} height={photo.height} alt={photo.alt[lang]} decoding="async" />}
      </figure>;
    })}
  </div>
  <div class="hero-slides__controls js-only">
    <button class="hero-slides__toggle" type="button" data-hero-toggle aria-pressed="false" data-pause={vi ? 'Tạm dừng trình chiếu' : 'Pause slideshow'} data-play={vi ? 'Phát trình chiếu' : 'Play slideshow'} aria-label={vi ? 'Tạm dừng trình chiếu' : 'Pause slideshow'}>
      <svg class="hero-slides__pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6v12M15 6v12" /></svg>
      <svg class="hero-slides__play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10-6.5-10-6.5Z" /></svg>
    </button>
    <div class="hero-slides__dots">
      {slides.map((photo, index) => <button type="button" data-hero-dot aria-label={`${vi ? 'Ảnh' : 'Photo'} ${index + 1}/${slides.length}`} aria-current={index === 0 ? 'true' : undefined}></button>)}
    </div>
  </div>
  <p class="sr-only" aria-live="polite" data-hero-live></p>
</div>
<script>
  import '../scripts/hero-slides';
</script>
