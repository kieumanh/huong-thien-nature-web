---
import EcosystemOrbit from './EcosystemOrbit.astro';
import HomePhoto from './HomePhoto.astro';
import RiceLandscapes from './RiceLandscapes.astro';
import { articlePath, journalPath } from '../data/articles';
import { journeyPath } from '../data/journey-pages';
import { shopPath } from '../data/products';
import { getCopy, type Language } from '../data/site';

const { lang } = Astro.props as { lang: Language };
const vi = lang === 'vi';
const t = getCopy(lang);
const links = [
  [shopPath(lang), vi ? 'Ghé cửa hàng' : 'Browse the shop'],
  [articlePath(lang, 'listening-to-nature'), vi ? 'Thử đi bộ chánh niệm' : 'Try a mindful walk'],
  [journalPath(lang), vi ? 'Khám phá Tản văn' : 'Explore the journal'],
];
---
<section class="home-ecosystem home-ecosystem-story" id="nature" aria-labelledby="nature-title">
  <div class="shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{vi ? 'Hệ sinh thái' : 'Ecosystem'}</p>
        <h2 id="nature-title">{vi ? 'Từ bữa cơm đến một cách sống' : 'From a meal to a way of living'}</h2>
      </div>
    </div>
    <p class="lead">{t.natureCopy}</p>
    <EcosystemOrbit {lang} cards={t.natureCards} images={['roots-garden.webp', 'vietnam-rice-fields.jpg', 'farmer-field.jpg']} {links} />
    <section class="reading-section" id="path">
      <h3>{vi ? 'Hiện tại mình có thể tham gia gì?' : 'What can I do right now?'}</h3>
      <p class="ecosystem-note">{t.natureNote}</p>
      <dl class="ecosystem-current">{t.phases.map(([, title, description]) => <div class="zen-card"><dt>{title}</dt><dd>{description}</dd></div>)}</dl>
      <a class="quiet-link" href={journeyPath(lang, 'ecosystem')}>{vi ? 'Đọc định hướng phát triển' : 'Read our development plans'}</a>
    </section>
    <section class="reading-section ecosystem-photos">
      <h3>{vi ? 'Ảnh thiên nhiên và đời sống' : 'Photographs from nature and everyday life'}</h3>
      <div class="nature-photos">
        <figure><HomePhoto photo="outdoor-kitchen" {lang} /><figcaption>{vi ? 'Sửa soạn bữa ăn bên bếp củi' : 'Preparing a meal outdoors'}</figcaption></figure>
        <figure><HomePhoto photo="together-by-sea" {lang} /><figcaption>{vi ? 'Một khoảnh khắc bên nhau ngoài biển' : 'A moment together by the sea'}</figcaption></figure>
      </div>
      <RiceLandscapes {lang} />
      <a class="quiet-link" href={`${journeyPath(lang, 'team')}#doi-tac`}>{vi ? 'Gặp những người đồng hành' : 'Meet the people we work with'}</a>
    </section>
  </div>
</section>
