---
import AnimatedIcon from './AnimatedIcon.astro';
import EcosystemOrbit from './EcosystemOrbit.astro';
import { journeyPath } from '../data/journey-pages';
import { themeById, themePath } from '../data/shop-themes';
import { getCopy, type Language } from '../data/site';
import '../styles/landing.css';

const { lang } = Astro.props as { lang: Language };
const vi = lang === 'vi';
const t = getCopy(lang);
// Card order follows t.natureCards: nature (Thân), practice (Tâm), support (Trí).
const links = [
  [`${journeyPath(lang, 'ecosystem')}#partnerships`, vi ? 'Gặp farm đối tác' : 'Meet our partner farm'],
  [journeyPath(lang, 'guidance'), vi ? 'Xem khóa thực hành' : 'See the practice courses'],
  [themePath(lang, themeById('da-nang-luong')!), vi ? 'Xem đá năng lượng' : 'See energy stones'],
];
const photos = ['veggie-bed-trellis', 'beach-meditate-calm', 'altar-flowers'];
const focus = ['50% 60%', '50% 28%', '50% 50%'];
const stepIcons = ['book', 'chat', 'sprout'] as const;
---
<section class="home-ecosystem home-ecosystem-story landing-band" id="nature" aria-labelledby="nature-title">
  <div class="shell">
    <div class="landing-head" data-reveal="up">
      <p class="eyebrow">{vi ? 'Hệ sinh thái' : 'Ecosystem'}</p>
      <h2 id="nature-title">{t.natureTitle}</h2>
    </div>
    <EcosystemOrbit {lang} cards={t.natureCards} {links} {photos} {focus} />
    <section class="landing-steps" id="path" aria-labelledby="path-title">
      <h3 id="path-title" data-reveal="up">{vi ? 'Hiện tại mình có thể tham gia gì?' : 'What can I do right now?'}</h3>
      <ol class="landing-steps__list">
        {t.phases.map(([, title], index) => <li data-reveal="fade">
          <span class={`landing-icon ${index === 1 ? 'landing-icon--orchid' : index === 2 ? 'landing-icon--gold' : ''}`}><AnimatedIcon name={stepIcons[index]} /></span>
          <span>{title}</span>
        </li>)}
      </ol>
      <p class="ecosystem-note">{t.natureNote}</p>
      <a class="quiet-link" href={journeyPath(lang, 'ecosystem')}>{vi ? 'Khám phá toàn bộ hệ sinh thái' : 'Explore the whole ecosystem'}</a>
    </section>
  </div>
</section>
