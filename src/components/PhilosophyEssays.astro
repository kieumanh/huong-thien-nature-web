---
// Section 09: journal pieces that already speak about these values. Only published articles are listed; the Living Zen
// Series (src/data/philosophy.ts) stays unpublished data until each piece is approved.
import ArticleCard from './ArticleCard.astro';
import Arrow from './Arrow.astro';
import { articles, journalPath } from '../data/articles';
import { philosophyCopy, philosophyEssays } from '../data/philosophy';
import type { Language } from '../data/site';
import '../styles/editorial.css';

interface Props { lang: Language }
const { lang } = Astro.props as Props;
const copy = philosophyCopy[lang].essays;
const picked = philosophyEssays.map(slug => articles.find(article => article.slug === slug)).filter(Boolean) as typeof articles;
---
{picked.length > 0 && <section class="ph-section ph-essays" id="ph-essays" aria-labelledby="ph-essays-title">
  <div class="ph-head" data-reveal="up">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="ph-essays-title">{copy.title}</h2>
    <p class="lead">{copy.lead}</p>
  </div>
  <div class="journal-grid ph-essays__grid">
    {picked.map(article => <ArticleCard {article} {lang} heading="h3" />)}
  </div>
  <p class="ph-essays__more"><a class="quiet-link" href={journalPath(lang)}>{copy.all} <Arrow /></a></p>
</section>}
