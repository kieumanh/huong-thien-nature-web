---
import Arrow from './Arrow.astro';
import { contactCopy, contactInterests } from '../data/contact';
import type { Language } from '../data/site';
import { products } from '../data/products';
// `topic` pre-fills an allow-listed enquiry when the form is embedded on a course page (see contact-form.ts).
const { lang, standalone = false, topic } = Astro.props as { lang: Language; standalone?: boolean; topic?: string };
const t = contactCopy[lang];
---
<div class="contact-card zen-card">
  {standalone ? <h2>{t.title}</h2> : <h3>{t.title}</h3>}
  <form id="interest-form" data-language={lang} data-topic={topic} data-products={JSON.stringify(products.map(product => ({ slug: product.slug, name: product.translations[lang].name })))} method="post">
    <fieldset disabled><legend class="sr-only">{t.title}</legend>
      <div class="contact-fields">
        <div class="contact-field"><label for="name">{t.name}</label><input id="name" name="name" autocomplete="name" maxlength="100" placeholder={lang === 'vi' ? 'Tên của bạn' : 'Your name'} required /></div>
        <div class="contact-field"><label for="email">{t.email}</label><input id="email" name="email" type="email" autocomplete="email" maxlength="254" placeholder="you@example.com" required /></div>
      </div>
      <label for="interest">{t.interest}</label>
      <div class="contact-select">
        <select id="interest" name="interest" required><option value="" selected disabled>{t.options[0]}</option>{contactInterests.map((value, index) => <option value={value}>{t.options[index + 1]}</option>)}</select>
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3.5 6 8 10.5 12.5 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </div>
      <label for="message">{t.message}</label>
      <textarea id="message" name="message" minlength="10" maxlength="5000" rows="4" aria-describedby="message-hint" placeholder={lang === 'vi' ? 'Bạn muốn chia sẻ điều gì?' : 'What would you like to share?'} required></textarea>
      <p class="contact-hint" id="message-hint"><span>{t.messageHint}</span><span class="contact-count" aria-hidden="true"><span id="message-count">0</span>/5000</span></p>
      <div class="contact-honeypot" aria-hidden="true"><label for="website">{t.honeypot}</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
      <p class="contact-privacy">{t.privacy}</p>
      <label class="contact-consent" for="consent"><input id="consent" name="consent" type="checkbox" required /><span>{t.consent}</span></label>
      <div id="contact-verification" class="contact-verification"></div>
      <button class="button" type="submit" disabled><span class="send-label">{t.send}</span><Arrow /></button>
    </fieldset>
    <p class="form-result" id="form-result" role="status" aria-live="polite"></p>
    <noscript><style>#interest-form fieldset { display: none; }</style><p class="form-note">{t.noScript}</p></noscript>
  </form>
</div>
<style>
  .contact-card h2, .contact-card h3 { color: var(--gold-accent); }
  .contact-card label { color: var(--gold-accent); letter-spacing: .01em; }
  .contact-card :is(input:not([type=checkbox]), select, textarea) {
    border: 1px solid color-mix(in srgb, var(--gold-accent) 60%, transparent);
    background: color-mix(in srgb, var(--surface-raised) 80%, transparent);
    transition: border-color .2s ease, box-shadow .2s ease;
  }
  .contact-card :is(input:not([type=checkbox]), select, textarea):focus-visible {
    border-color: var(--gold); box-shadow: 0 0 0 3px color-mix(in srgb, var(--gold) 35%, transparent);
  }
  .contact-select { position: relative; }
  .contact-select select { appearance: none; padding-right: 2.75rem; cursor: pointer; }
  .contact-select svg { position: absolute; right: 1rem; top: 50%; width: 1rem; height: 1rem; transform: translateY(-50%); color: var(--gold-accent); pointer-events: none; }
  .contact-select select:invalid { color: var(--muted); }
  .contact-hint { display: flex; justify-content: space-between; gap: .75rem; margin: .35rem 0 0; color: var(--muted); font-size: var(--type-caption); line-height: 1.5; }
  .contact-count { flex: none; font-variant-numeric: tabular-nums; }
  .contact-privacy { margin: .9rem 0 0; color: var(--muted); font-size: var(--type-caption); line-height: 1.6; }
  .contact-card .contact-consent {
    margin-top: .65rem; padding: .7rem .9rem; border: 1px solid color-mix(in srgb, var(--gold-accent) 60%, transparent);
    border-radius: var(--radius-input); background: color-mix(in srgb, var(--gold) 9%, transparent); cursor: pointer;
  }
  .contact-card .contact-consent { color: var(--foreground); font-weight: 500; }
  .contact-consent input { accent-color: var(--gold-deep); }
  .contact-card .button { width: 100%; justify-content: center; margin-top: .9rem; }
  @media (min-width: 580px) { .contact-card .button { width: auto; } }
</style>
<script>
  import '../scripts/contact-form';
  const message = document.getElementById('message') as HTMLTextAreaElement | null;
  const count = document.getElementById('message-count');
  const updateCount = () => { if (message && count) count.textContent = String(message.value.length); };
  message?.addEventListener('input', updateCount);
  updateCount();
</script>
