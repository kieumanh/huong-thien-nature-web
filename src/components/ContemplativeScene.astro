---
interface Props {
  motif: 'meditation' | 'yoga' | 'mandala' | 'sprig';
}
const { motif } = Astro.props;
const petals = Array.from({ length: 12 }, (_, index) => index);
---
<div class:list={['contemplative-scene', `contemplative-scene--${motif}`]} data-contemplative-scene aria-hidden="true">
  {motif === 'mandala' ? (
    <div class="mandala-ring">
      {petals.map(index => <span style={`--angle: ${index * 30}deg`}></span>)}
    </div>
  ) : motif === 'sprig' ? (
    <img src="/media/botanical-sprig.svg" alt="" width="240" height="360" loading="lazy" decoding="async" />
  ) : (
    <>
      <img
        src={motif === 'meditation' ? '/media/meditation-forest.webp' : '/media/yoga-tree-pose.webp'}
        srcset={motif === 'meditation' ? '/media/meditation-forest-480.webp 480w, /media/meditation-forest-800.webp 800w, /media/meditation-forest.webp 1500w' : undefined}
        sizes={motif === 'meditation' ? '(max-width: 759px) 94vw, (max-width: 1300px) 47vw, 610px' : undefined}
        alt=""
        width={motif === 'meditation' ? 1500 : 1080}
        height={motif === 'meditation' ? 1000 : 678}
        loading={motif === 'meditation' ? 'eager' : 'lazy'}
        fetchpriority={motif === 'meditation' ? 'high' : 'auto'}
        decoding="async"
      />
      <span class="scene-glow"></span>
    </>
  )}
</div>

<script>
  const scenes = document.querySelectorAll('[data-contemplative-scene]');
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(entries => {
      for (const { target, isIntersecting } of entries) {
        target.classList.toggle('scene-visible', isIntersecting);
      }
    });
    const update = () => {
      observer.disconnect();
      for (const scene of scenes) {
        scene.classList.remove('scene-visible');
        if (!motion.matches && !connection?.saveData && !document.hidden) observer.observe(scene);
      }
    };
    motion.addEventListener('change', update);
    document.addEventListener('visibilitychange', update);
    update();
  }
</script>

<style>
  .contemplative-scene {
    isolation: isolate;
    display: grid;
    place-items: center;
    overflow: hidden;
    min-width: 0;
    pointer-events: none;
  }

  :where(.contemplative-scene) { position: relative; }

  .contemplative-scene img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .contemplative-scene--meditation { aspect-ratio: 5 / 4; background: #426451; }
  .contemplative-scene--meditation img { animation: scene-breathe 4.8s ease-in-out both; }
  .contemplative-scene--yoga { aspect-ratio: 5 / 4; background: #79533f; }
  .contemplative-scene--yoga img { animation: yoga-drift 4.8s ease-in-out both; }
  .scene-glow {
    position: absolute;
    inset: -20%;
    background: radial-gradient(ellipse at 68% 35%, #fff2c866, transparent 48%);
    animation: glow-drift 4.8s ease-in-out both;
    mix-blend-mode: screen;
  }

  .contemplative-scene--mandala, .contemplative-scene--sprig { aspect-ratio: 1; }
  .contemplative-scene--sprig img {
    object-fit: contain;
    transform-origin: center bottom;
    animation: sprig-sway 4.5s ease-in-out both;
  }
  .mandala-ring {
    position: relative;
    display: grid;
    place-items: center;
    width: 80%;
    aspect-ratio: 1;
    color: #537453;
    border: 1px solid currentColor;
    border-radius: 50%;
    animation: mandala-turn 4.5s ease-in-out both;
  }
  .mandala-ring::before {
    content: '';
    position: absolute;
    inset: 7%;
    border: 1px solid currentColor;
    border-radius: 50%;
  }
  .mandala-ring span {
    position: absolute;
    width: 28%;
    height: 64%;
    border: 1px solid currentColor;
    border-radius: 72% 28% 72% 28%;
    transform: rotate(var(--angle));
  }

  .contemplative-scene :is(img, .scene-glow, .mandala-ring) { animation-play-state: paused; }
  .scene-visible :is(img, .scene-glow, .mandala-ring) { animation-play-state: running; }

  @keyframes scene-breathe { from { transform: scale(1.015); } to { transform: scale(1.075); } }
  @keyframes yoga-drift { from { transform: scale(1.04) translateX(-1%); } to { transform: scale(1.10) translateX(2%); } }
  @keyframes glow-drift { from { transform: translate(-7%, 2%); opacity: .48; } to { transform: translate(6%, -5%); opacity: .85; } }
  @keyframes mandala-turn { 55% { transform: rotate(18deg) scale(1.035); } to { transform: rotate(30deg); } }
  @keyframes sprig-sway { 50% { transform: rotate(7deg); } }

  @media (prefers-reduced-motion: reduce) {
    .contemplative-scene :is(img, .scene-glow, .mandala-ring) { animation: none; }
  }
</style>
