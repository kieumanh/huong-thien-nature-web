---
const particles = [
  [11, -2, 9], [27, -7, 13], [53, -4, 10], [72, -9, 16],
  [38, -12, 14], [88, -6, 11], [61, -1, 15], [18, -11, 12],
  [82, -13, 17], [47, -6, 19],
];
---
<div class="seasonal-accent" aria-hidden="true">
  <div class="season-sun"></div>
  <div class="season-swallows">
    {[0, 1, 2].map(index => (
      <div class="season-flight" style={`--bird:${index}`}>
        <svg class="season-bird" viewBox="0 0 36 18" width="28" height="14" focusable="false">
          <path d="M35 2c-6 0-12 2-17 6C13 4 8 2 1 1c6 3 9 9 15 10l-5 6 7-3 6 3-4-6C27 10 29 5 35 2Z" />
        </svg>
      </div>
    ))}
  </div>
  <div class="season-leaves">
    {particles.map(([x, delay, duration], index) => (
      <span class:list={['season-leaf', { 'season-leaf--extra': index >= 6 }]}
        style={`--x:${x}%;--delay:${delay}s;--fall-time:${duration}s`}></span>
    ))}
  </div>
  {['left', 'right'].map(side => (
    <div class={`season-bank season-bank--${side}`}>
      {particles.map(([x, delay, duration], index) => (
        <span class:list={['season-particle', { 'season-particle--extra': index >= 5 }]}
          style={`--x:${x}%;--delay:${delay}s;--fall-time:${duration}s`}></span>
      ))}
      <span class="season-gust"></span>
      <span class="season-runoff"></span>
    </div>
  ))}
</div>

<script>
  import { seasonSceneAt } from '../scripts/seasons';

  const root = document.documentElement;
  let timer: ReturnType<typeof setTimeout>;

  function syncSeason() {
    clearTimeout(timer);
    root.toggleAttribute('data-season-paused', document.hidden);
    if (document.hidden) return;
    const now = Date.now();
    const { season, weather, nextChangeAt } = seasonSceneAt(now);
    root.dataset.season = season;
    root.dataset.weather = weather;
    timer = setTimeout(syncSeason, nextChangeAt - now);
  }

  document.addEventListener('visibilitychange', syncSeason);
  window.addEventListener('pageshow', syncSeason);
  syncSeason();
</script>
