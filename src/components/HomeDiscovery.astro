---
import Arrow from './Arrow.astro';
import { homeCopy, beginnerArticles } from '../data/home';
import { articles, articlePath, journalPath } from '../data/articles';
import type { Language } from '../data/site';
const { lang } = Astro.props as { lang: Language };
const t = homeCopy[lang];
const searchPath = lang === 'vi' ? '/vi/timkiem/' : '/en/search/';
---
<section class="home-discovery shell" aria-labelledby="discovery-title">
  <div class="home-discovery-content">
    <span class="eyebrow">{t.searchEyebrow}</span>
    <h2 id="discovery-title">{t.searchTitle}</h2>
    <p>{t.searchDescription}</p>
    <form class="home-search-form" action={searchPath} method="get" role="search" aria-label={t.searchLabel}>
      <label class="sr-only" for="home-search-query">{t.searchLabel}</label>
      <div class="home-search-fields"><input id="home-search-query" name="q" type="search" maxlength="120" required placeholder={t.searchPlaceholder} autocomplete="off" /><button class="button" type="submit">{t.searchButton} <Arrow /></button></div>
    </form>
    <nav class="home-search-suggestions" aria-label={t.suggestionsLabel}>{t.suggestions.map(query => <a href={`${searchPath}?q=${encodeURIComponent(query)}`}>{query}</a>)}</nav>
    <div class="home-library-summary"><span>{articles.length} {t.library}</span><a class="quiet-link" href={journalPath(lang)}>{t.browse} <Arrow /></a></div>
    <div class="home-beginner-links">
      <span class="home-beginner-label">{t.readingEyebrow}</span>
      <nav aria-label={t.readingEyebrow}>{beginnerArticles.map((article, index) => <a class="home-beginner-link" href={articlePath(lang, article.slug)}><span>0{index + 1}</span>{article.translations[lang].title}<Arrow /></a>)}</nav>
    </div>
  </div>
</section>
