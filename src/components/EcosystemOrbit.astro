---
import type { Language } from '../data/site';
import Arrow from './Arrow.astro';
import AlbumImage from './AlbumImage.astro';
import PillarIcon from './PillarIcon.astro';
// `photos`: one album id per card (in card order), shown above the text; `focus` is the CSS object-position of each photo.
const { lang, cards, links, photos = [], focus = [] } = Astro.props as { lang: Language; cards: string[][]; links: string[][]; photos?: string[]; focus?: string[] };
const pillarIcons = ['seed', 'meditation', 'mind'] as const;
const en = lang === 'en';
const values = en ? ['BODY', 'HEART', 'MIND'] : ['THÂN', 'TÂM', 'TRÍ'];
const status = en ? ['With partner farms', 'Courses available', 'Shop available'] : ['Cùng farm đối tác', 'Có khóa thực hành', 'Có Cửa hàng'];
const orbitDurations = ['26s', '42s', '58s'];
---
<div class="ecosystem-motion" data-ecosystem>

  <section class="reading-section ecosystem-visual">
    <h3 class="reading-heading sr-only">{en ? 'Three orbits around awareness' : 'Ba quỹ đạo quanh sự nhận biết'}</h3>
  <figure class="ecosystem-solar-system" aria-label={en ? 'Awareness at the centre, with three planets for Body, Heart and Mind.' : 'Nhận biết ở trung tâm, cùng ba hành tinh Thân, Tâm và Trí.'}>
    <div class="solar-system-scene" aria-hidden="true">
      <div class="solar-system-starfield"></div>
      {[0, 1, 2].map((index) => <div class={`solar-orbit solar-orbit--${index + 1}`} style={`--orbit-duration:${orbitDurations[index]};--orbit-delay:${index * -8}s;--origin-angle:${index * 120}deg`}>
        <div class="solar-orbit-line"></div>
        <div class="solar-planet-counter">
          <div class={`solar-planet solar-planet--${index + 1}`}>
            {index === 0 ? (
              <svg class="solar-planet__art" viewBox="0 0 64 64" focusable="false">
                <circle cx="47" cy="16" r="7" fill="currentColor" opacity=".24" />
                <path d="M8 49h48M13 55h38" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity=".55" />
                <path d="M32 49V25m0 13c-10-1-15-7-15-15 9 0 15 4 15 15Zm0-5c0-10 6-16 16-16 0 9-5 15-16 16Zm-8 7c-7 0-11-4-12-10 7 0 11 3 12 10Z" fill="#edf3ce" stroke="#f8f6e9" stroke-width="2" stroke-linejoin="round" />
              </svg>
            ) : index === 1 ? (
              <svg class="solar-planet__art" viewBox="0 0 64 64" focusable="false">
                <path d="M32 50s-22-12-22-27c0-10 13-15 22-3 9-12 22-7 22 3 0 15-22 27-22 27Z" fill="#f0d8d7" stroke="#fff7ee" stroke-width="2" stroke-linejoin="round" />
                <path d="M32 46V32m0 9c-9 0-14-5-14-13 8 0 13 5 14 13Zm0-5c0-8 5-13 14-13 0 8-5 13-14 13Z" fill="#91aa7d" stroke="#eaf0d8" stroke-width="1.6" stroke-linejoin="round" />
              </svg>
            ) : (
              <svg class="solar-planet__art" viewBox="0 0 64 64" focusable="false">
                <path d="M8 18c9-3 17-2 24 3v31c-7-5-15-6-24-3V18Zm48 0c-9-3-17-2-24 3v31c7-5 15-6 24-3V18Z" fill="#f4e8bc" stroke="#fff8e9" stroke-width="2" stroke-linejoin="round" />
                <path d="m32 13 2.2 4.8 5.2.6-3.9 3.4 1.1 5.1-4.6-2.6-4.6 2.6 1.1-5.1-3.9-3.4 5.2-.6L32 13Z" fill="#fff1a7" />
                <path d="M14 25h11m-11 6h11m14-6h11m-11 6h11" stroke="#7b795e" stroke-width="1.6" stroke-linecap="round" opacity=".75" />
              </svg>
            )}
            <span>{values[index]}</span>
          </div>
        </div>
      </div>)}
      <div class="solar-sun"><span class="solar-sun__symbol" aria-hidden="true">✦</span><span>{en ? 'Awareness' : 'Nhận biết'}</span></div>
    </div>
    <figcaption class="solar-system-caption">{en ? 'One shared home, held by care for body, heart and mind.' : 'Một mái nhà chung, được nuôi dưỡng từ Thân, chăm sóc Tâm và mở sáng Trí.'}</figcaption>
  </figure>

  </section>

  <div class="solar-system-pillars">
    {cards.map(([title, text], index) => <article class={`solar-pillar solar-pillar--${index + 1}`} data-reveal="fade">
      {photos[index] && <figure class="solar-pillar__photo" style={focus[index] ? `--pp:${focus[index]}` : undefined}><AlbumImage id={photos[index]} {lang} sizes="(min-width: 900px) 30vw, 92vw" /></figure>}
      <div class="solar-pillar__body">
        <span class="solar-pillar__badge"><PillarIcon name={pillarIcons[index]} /></span>
        <span class="solar-pillar__index">{values[index]}</span>
        <h3>{title}</h3>
        <p>{text}</p>
        <span class="ecosystem-status">{status[index]}</span>
        <a class="quiet-link" href={links[index][0]}>{links[index][1]} <Arrow /></a>
      </div>
    </article>)}
  </div>
</div>
<script>
  import '../scripts/ecosystem-orbit';
</script>
