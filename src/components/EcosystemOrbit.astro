---
import type { Language } from '../data/site';
import Arrow from './Arrow.astro';
const { lang, cards, links } = Astro.props as { lang: Language; cards: string[][]; links: string[][] };
const en = lang === 'en';
const values = en ? ['BODY', 'HEART', 'MIND'] : ['THÂN', 'TÂM', 'TRÍ'];
const status = en ? ['Shop available', 'In preparation', 'In preparation'] : ['Có cửa hàng', 'Đang chuẩn bị', 'Đang chuẩn bị'];
const planets = [['than', 26], ['tam', 42], ['tri', 58]] as const;
---
<div class="ecosystem-motion" data-ecosystem>

  <div class="solar-system-pillars">
    {cards.map(([title, text], index) => <article class={`solar-pillar solar-pillar--${index + 1}`}>
      <span class="solar-pillar__index">{values[index]}</span>
      <h3>{title}</h3>
      <p>{text}</p>
      <span class="ecosystem-status">{status[index]}</span>
      <a class="quiet-link" href={links[index][0]}>{links[index][1]} <Arrow /></a>
    </article>)}
  </div>
  <section class="reading-section ecosystem-visual">
    <h3 class="reading-heading">{en ? 'The three orbits' : 'Mô hình ba quỹ đạo'}</h3>
  <figure class="ecosystem-solar-system" aria-label={en ? 'Hương Thiền Nature at the centre, with three planets for Body, Heart and Mind.' : 'Hương Thiền Nature ở trung tâm, cùng ba hành tinh Thân, Tâm và Trí.'}>
    <div class="solar-system-scene" aria-hidden="true">
      <div class="solar-system-starfield"></div>
      {planets.map(([planet, seconds], index) => <div class={`solar-orbit solar-orbit--${index + 1}`} style={`--orbit-duration:${seconds}s;--origin-angle:${50 + index * 120}deg`}>
        <div class="solar-orbit-line"></div>
        <div class="solar-planet-counter">
          <div class={`solar-planet solar-planet--${index + 1}`}>
            <img src={`/media/planet-${planet}.webp`} alt="" width="192" height="192" loading="lazy" decoding="async" />
            <span>{values[index]}</span>
          </div>
        </div>
      </div>)}
      <div class="solar-sun"><span class="solar-sun__symbol" aria-hidden="true">✦</span><span>Hương Thiền<br/>Nature</span></div>
    </div>
    <figcaption class="solar-system-caption">{en ? 'One shared home, held by care for body, heart and mind.' : 'Một mái nhà chung, được nuôi dưỡng từ Thân, chăm sóc Tâm và mở sáng Trí.'}</figcaption>
  </figure>

  </section>
</div>
<script>
  import '../scripts/ecosystem-orbit';
</script>
