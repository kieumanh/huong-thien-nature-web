---
// The "lost for a breath" 404 page, built once per language: src/pages/404.astro (Vietnamese) and src/pages/en/404.astro (English).
// The host serves the nearest 404.html, so an unknown /en/… address gets this English page with English header and footer.
import Arrow from './Arrow.astro';
import AnimatedIcon from './AnimatedIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import '../styles/animated-icons.css';
import { journeyPath } from '../data/journey-pages';
import { journalPath } from '../data/articles';
import { contactPath } from '../data/contact-channels';
import type { Language } from '../data/site';

const { lang } = Astro.props as { lang: Language };
const vi = lang === 'vi';

const copy = {
  vi: {
      title: 'Không tìm thấy trang | Hương Thiền Nature',
      description: 'Trang bạn đang tìm không có ở đây.',
      eyebrow: '404 · Lạc một nhịp',
      heading: 'Không tìm thấy trang này.',
      lead: 'Có lẽ con đường này vừa rẽ sang một lối khác. Không sao, hít một hơi thở chậm rồi mình đi tiếp nhé.',
      back: 'Quay lại trang trước',
      home: 'Về trang chủ',
      homePath: '/vi/',
      meanwhile: 'Hoặc ghé một nơi gần đây',
      address: 'Địa chỉ không có ở đây:',
      links: [[journeyPath('vi', 'practice'), 'Gợi ý thực hành', 'breath'], [journalPath('vi'), 'Tản văn', 'book'], [journeyPath('vi', 'ecosystem'), 'Hệ sinh thái', 'sprout'], [contactPath('vi'), 'Nhắn cho tụi mình', 'chat']],
      alternatePath: '/en/',
  },
  en: {
      title: 'Page not found | Hương Thiền Nature',
      description: 'The page you are looking for is not here.',
      eyebrow: '404 · Lost for a breath',
      heading: 'We couldn’t find this page.',
      lead: 'Perhaps this path just turned another way. That’s alright. Take one slow breath and we’ll go on from here.',
      back: 'Go back',
      home: 'Back to the home page',
      homePath: '/en/',
      meanwhile: 'Or visit somewhere nearby',
      address: 'This address isn’t here:',
      links: [[journeyPath('en', 'practice'), 'Practice tips', 'breath'], [journalPath('en'), 'Essays', 'book'], [journeyPath('en', 'ecosystem'), 'Ecosystem', 'sprout'], [contactPath('en'), 'Write to us', 'chat']],
      alternatePath: '/vi/',
  },
} as const;
const c = vi ? copy.vi : copy.en;
---
<BaseLayout {lang} title={c.title} description={c.description} noindex>
  <Header {lang} alternatePath={c.alternatePath} />
  <main class="error-page" id="main-content" tabindex="-1" data-not-found>
    <div class="shell lost">
      <div class="lost__scene" aria-hidden="true">
        <span class="lost__digit">4</span>
        <span class="lost__orb"><span class="lost__halo"></span><span class="lost__core"><AnimatedIcon name="path" /></span></span>
        <span class="lost__digit">4</span>
        <span class="lost__leaf lost__leaf--1"><AnimatedIcon name="leaf" /></span>
        <span class="lost__leaf lost__leaf--2"><AnimatedIcon name="lotus" /></span>
        <span class="lost__leaf lost__leaf--3"><AnimatedIcon name="leaf" /></span>
      </div>
      <div class="lost__copy">
        <span class="eyebrow">{c.eyebrow}</span>
        <h1>{c.heading}</h1>
        <p class="lead">{c.lead}</p>
        <div class="lost__actions">
          <a class="button" href={c.homePath}>{c.home} <Arrow /></a>
          <button class="button button--tonal lost__back" type="button" data-lost-back hidden>{c.back}</button>
        </div>
        <p class="lost__path"><span>{c.address}</span> <code data-lost-path></code></p>
        <nav class="lost__near" aria-label={c.meanwhile}>
          <p>{c.meanwhile}</p>
          <ul role="list">{c.links.map(([href, label, icon]) => <li><a href={href}><span class="landing-icon"><AnimatedIcon name={icon} /></span>{label}</a></li>)}</ul>
        </nav>
      </div>
    </div>
  </main>
  <Footer {lang} />
</BaseLayout>
<script>
  const page = document.querySelector<HTMLElement>('[data-not-found]');
  if (page) {
    for (const target of page.querySelectorAll<HTMLElement>('[data-lost-path]')) target.textContent = decodeURIComponentSafe(location.pathname).slice(0, 120);
    const sameSite = document.referrer && new URL(document.referrer).origin === location.origin;
    for (const button of page.querySelectorAll<HTMLButtonElement>('[data-lost-back]')) {
      button.hidden = !(sameSite && history.length > 1);
      button.addEventListener('click', () => history.back());
    }
  }
  function decodeURIComponentSafe(value: string) { try { return decodeURIComponent(value); } catch { return value; } }
</script>
<style>
  .lost { display: grid; justify-items: center; gap: clamp(1.4rem, 4vw, 2.4rem); padding-block: clamp(2.5rem, 8vw, 5.5rem); text-align: center; }
  .lost__scene { position: relative; display: flex; align-items: center; justify-content: center; gap: clamp(.4rem, 2vw, 1rem); width: min(100%, 30rem); padding: 1rem 0 .4rem; }
  .lost__digit { font: 500 clamp(5.5rem, 22vw, 9.5rem)/1 var(--serif); color: var(--primary); animation: lost-bob 7s ease-in-out infinite; }
  .lost__digit:last-of-type { animation-delay: -3.5s; }
  .lost__orb { position: relative; display: grid; place-items: center; width: clamp(5.2rem, 20vw, 8.6rem); aspect-ratio: 1; }
  .lost__halo, .lost__core { position: absolute; border-radius: 50%; }
  .lost__halo { inset: -12%; background: radial-gradient(circle, color-mix(in srgb, var(--gold-soft, #e8c97a) 70%, transparent), transparent 70%); animation: lost-breath 10s ease-in-out infinite; }
  .lost__core { inset: 6%; display: grid; place-items: center; border: 2px solid var(--moss, #6b8f5e); background: var(--surface-raised); color: var(--primary); box-shadow: 0 10px 28px #2a3a2a26; animation: lost-breath-core 10s ease-in-out infinite; }
  .lost__core :global(.ai) { width: 46%; height: 46%; }
  .lost__leaf { position: absolute; color: var(--moss, #6b8f5e); opacity: .85; animation: lost-fall 11s ease-in-out infinite; }
  .lost__leaf :global(.ai) { width: 1.6rem; height: 1.6rem; }
  .lost__leaf--1 { top: 0; left: 8%; }
  .lost__leaf--2 { top: 6%; right: 6%; color: var(--orchid); animation-delay: -4s; }
  .lost__leaf--3 { bottom: 4%; left: 32%; animation-delay: -7s; }
  .lost__copy { display: grid; justify-items: center; gap: 1rem; max-width: 36rem; }
  .lost__copy h1 { margin: 0; text-wrap: balance; }
  .lost__copy .lead { margin: 0; text-wrap: balance; }
  .lost__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: .7rem; }
  .lost__actions [hidden] { display: none; }
  .lost__path { margin: 0; color: var(--muted); font-size: .85rem; overflow-wrap: anywhere; }
  .lost__path code { font-family: inherit; color: var(--foreground); }
  .lost__near { margin-top: .6rem; width: 100%; }
  .lost__near p { margin: 0 0 .6rem; color: var(--muted); font-size: .9rem; }
  .lost__near ul { display: flex; flex-wrap: wrap; justify-content: center; gap: .6rem; margin: 0; padding: 0; list-style: none; }
  .lost__near a { display: inline-flex; align-items: center; gap: .55rem; min-height: 48px; padding: .25rem 1rem .25rem .3rem; border: 1px solid var(--border); border-radius: 999px; background: var(--surface-raised); font-weight: 600; }
  .lost__near a:is(:hover, :focus-visible) { background: var(--orchid-mist); color: var(--orchid-deep); }
  .lost__near .landing-icon { width: 2.2rem; height: 2.2rem; }
  @keyframes lost-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-.6rem); } }
  @keyframes lost-breath { 0%, 100% { transform: scale(.82); opacity: .55; } 40% { transform: scale(1.12); opacity: 1; } }
  @keyframes lost-breath-core { 0%, 100% { transform: scale(.94); } 40% { transform: scale(1.04); } }
  @keyframes lost-fall { 0%, 100% { transform: translate(0, 0) rotate(-8deg); } 50% { transform: translate(.8rem, 1.3rem) rotate(14deg); } }
  @media (prefers-reduced-motion: reduce) { .lost__digit, .lost__halo, .lost__core, .lost__leaf { animation: none; } }
</style>
