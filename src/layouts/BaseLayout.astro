---
import '../styles/global.css';
import '../styles/seasons.css';
import PageLoader from '../components/PageLoader.astro';
import SeasonalAccent from '../components/SeasonalAccent.astro';
import { contactEmail, internationalPhone } from '../data/contact-channels';
import BackgroundMusic from '../components/BackgroundMusic.astro';
import BackToTop from '../components/BackToTop.astro';
import { meditationFounder, journalAuthor } from '../data/people';
import { journeyPath } from '../data/journey-pages';
import { version } from '../../package.json';
const origin = 'https://huongthiennature.com';
const organizationId = origin + '/#organization';
const websiteId = origin + '/#website';
const brandImage = '/media/huong-thien-ben-ho-social.jpg';
const { lang = 'vi', title, description, alternatePath, canonicalPath, image = brandImage, imageDetails, ogType = 'website', noindex = false, pageType = 'WebPage', aboutOrganization = false } = Astro.props;
const imageUrl = new URL(image, 'https://huongthiennature.com').href;
const brandAlt = lang === 'vi' ? 'Hương Thiền mỉm cười, hai tay tạo hình trái tim bên hồ dưới chân núi.' : 'Hương Thiền smiling by a mountain lake, making a heart with her hands.';
const socialImage = imageDetails ?? (image === brandImage ? { type: 'image/jpeg', width: 1200, height: 630, alt: brandAlt } : undefined);
const routePath = Astro.url.pathname;
const pathname = canonicalPath ?? (routePath.endsWith('/') || /\.[a-z]+$/i.test(routePath) ? routePath : `${routePath}/`);
const url = new URL(pathname, 'https://huongthiennature.com');
const enPath = lang === 'en' ? pathname : alternatePath;
const viPath = lang === 'vi' ? pathname : alternatePath;
const siteName = 'Hương Thiền Nature';
const teamUrl = origin + journeyPath(lang, 'team');
const people = [meditationFounder, journalAuthor].map((person, index) => ({
  '@type': 'Person',
  '@id': origin + (index === 0 ? '/#huong-thien' : '/#kieu-manh'),
  name: person.name,
  ...(index === 0 ? { alternateName: 'Đỗ Thị Kim Hương' } : {}),
  url: teamUrl + (index === 0 ? '#huong-thien' : '#kieu-manh'),
  image: new URL(person.image, origin).href,
  jobTitle: person.role[lang === 'vi' ? 'vi' : 'en'],
}));
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization', '@id': organizationId, name: siteName, url: origin,
      logo: origin + '/media/huong-thien-logo-forest.webp',
      contactPoint: { '@type': 'ContactPoint', email: contactEmail, telephone: internationalPhone, contactType: 'customer support', availableLanguage: ['vi', 'en'] },
      founder: people.map(person => ({ '@id': person['@id'] })),
    },
    { '@type': 'WebSite', '@id': websiteId, name: siteName, url: origin, inLanguage: ['vi', 'en'], publisher: { '@id': organizationId } },
    {
      '@type': pageType, '@id': url.href + '#webpage', url: url.href, name: title, description, inLanguage: lang, isPartOf: { '@id': websiteId },
      ...(aboutOrganization ? { about: { '@id': organizationId } } : {}),
    },
    ...people,
  ],
};

---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#243f32" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline src="/scripts/daylight.js"></script>
    <meta name="application-version" content={version} />
    <meta name="robots" content={noindex ? "noindex, follow" : "max-image-preview:large"} />
    <meta name="description" content={description} />
    <link rel="canonical" href={url.href} />
    {alternatePath && <>
      <link rel="alternate" hreflang="vi" href={`https://huongthiennature.com${viPath}`} />
      <link rel="alternate" hreflang="en" href={`https://huongthiennature.com${enPath}`} />
      <link rel="alternate" hreflang="x-default" href={`https://huongthiennature.com${viPath}`} />
    </>}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url.href} />
    <meta property="og:image" content={imageUrl} />
    {socialImage && <>
      <meta property="og:image:type" content={socialImage.type} />
      <meta property="og:image:width" content={socialImage.width} />
      <meta property="og:image:height" content={socialImage.height} />
      <meta property="og:image:alt" content={socialImage.alt} />
      <meta name="twitter:image:alt" content={socialImage.alt} />
    </>}
    {alternatePath && <meta property="og:locale:alternate" content={lang === 'vi' ? 'en_US' : 'vi_VN'} />}
    <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    {(!noindex && alternatePath) && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}

  </head>
  <body><PageLoader {lang} /><div class="reading-progress" role="progressbar" aria-label={lang === 'vi' ? 'Tiến trình đọc trang' : 'Page reading progress'} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div><SeasonalAccent /><slot /><BackgroundMusic lang={lang} /><BackToTop lang={lang} /></body>
  <script>
    import '../scripts/floating-contrast';
    import '../scripts/reading-progress';
  </script>
</html>
