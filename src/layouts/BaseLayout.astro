---
import '../styles/global.css';
import BackgroundMusic from '../components/BackgroundMusic.astro';
const { lang = 'vi', title, description, alternatePath, image = '/media/hero-canopy-v2.webp' } = Astro.props;
const pathname = Astro.url.pathname.endsWith('/') || /\.[a-z]+$/i.test(Astro.url.pathname)
  ? Astro.url.pathname : `${Astro.url.pathname}/`;
const url = new URL(pathname, 'https://huongthiennature.com');
const enPath = lang === 'en' ? pathname : alternatePath;
const viPath = lang === 'vi' ? pathname : alternatePath;
const siteName = 'Hương Thiền Nature';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#243f32" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    <link rel="canonical" href={url.href} />
    {alternatePath && <>
      <link rel="alternate" hreflang="vi" href={`https://huongthiennature.com${viPath}`} />
      <link rel="alternate" hreflang="en" href={`https://huongthiennature.com${enPath}`} />
      <link rel="alternate" hreflang="x-default" href={`https://huongthiennature.com${viPath}`} />
    </>}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url.href} />
    <meta property="og:image" content={new URL(image, 'https://huongthiennature.com').href} />
    <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, 'https://huongthiennature.com').href} />
    <link rel="icon" type="image/webp" href="/media/huong-thien-logo-forest.webp" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'Organization', name: siteName,
      url: 'https://huongthiennature.com', description,
      founder: [{ '@type': 'Person', name: 'Hương Thiền', jobTitle: 'Founder & Teacher' }, { '@type': 'Person', name: 'Kiều Mạnh', jobTitle: 'Co-founder & Teacher' }],
    })} />
  </head>
  <body><BackgroundMusic lang={lang} /><slot /></body>
</html>
