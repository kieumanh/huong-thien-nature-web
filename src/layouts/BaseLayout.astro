---
import '../styles/global.css';
const { lang = 'vi', title, description } = Astro.props;
const url = new URL(Astro.url.pathname, 'https://huongthiennature.com');
const enPath = Astro.url.pathname.replace(/^\/vi/, '/en');
const viPath = Astro.url.pathname.replace(/^\/en/, '/vi');
const siteName = 'Hương Thiền Nature';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f4eb" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <meta name="description" content={description} />
    <link rel="canonical" href={url.href} />
    <link rel="alternate" hreflang="vi" href={`https://huongthiennature.com${viPath}`} />
    <link rel="alternate" hreflang="en" href={`https://huongthiennature.com${enPath}`} />
    <link rel="alternate" hreflang="x-default" href="https://huongthiennature.com/vi" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url.href} />
    <meta property="og:image" content="https://huongthiennature.com/media/huong-thien-logo-light.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/webp" href="/media/huong-thien-logo-forest.webp" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'Organization', name: siteName,
      url: 'https://huongthiennature.com', description,
      founder: [{ '@type': 'Person', name: 'Hương Thiền', jobTitle: 'Founder & Teacher' }, { '@type': 'Person', name: 'Kiều Mạnh', jobTitle: 'Co-founder & Teacher' }],
    })} />
  </head>
  <body><slot /></body>
</html>
