{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huong-thien-nature",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
