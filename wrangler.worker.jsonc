{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "huong-thien-nature",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "huongthiennature.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
